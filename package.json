  "repository": {
    "type": "git",
    "url": "https://github.com/felix-berlin/berliner-schnauze"
  },
  "funding": [
    {
      "type": "GitHub Sponsors",
      "url": "https://github.com/sponsors/felix-berlin"
    },
    {
      "type": "Ko-fi",
      "url": "https://ko-fi.com/felixberlin"
    },
    {
      "type": "PayPal",
      "url": "https://paypal.me/FelixScholze"
    },
    {
      "type": "Buy me a coffee",
      "url": "https://www.buymeacoffee.com/felixberlin"
    }
  ],
  "type": "module",
  "scripts": {
    "preinstall": "pnpx only-allow pnpm",
    "dev": "pnpm --filter website dev",
    "build": "pnpm --filter website build",
    "build:local": "pnpm --filter website build:local",
    "test:unit": "pnpm --filter website test:unit",
    "lint": "pnpm --filter website lint",
    "typechecking": "pnpm --filter website typechecking",
    "format": "pnpm exec oxfmt .",
    "format:check": "pnpm exec oxfmt --check .",
    "cms:dev": "pnpm --filter payload-app dev",
    "cms:test": "pnpm --filter payload-app test",
    "cms:migrate": "pnpm --filter payload-app migrate",
    "cms:migrate:create": "pnpm --filter payload-app migrate:create",
    "browserslist:update": "pnpx update-browserslist-db@latest",
    "anki:build": "infisical run -- .venv-anki/bin/python scripts/build_anki_decks.py --version $npm_package_version-dev",
    "anki:push:sandbox": "infisical run -- env POLAR_SANDBOX=true .venv-anki/bin/python scripts/upload_anki_to_polar.py --version $npm_package_version-dev"
  },
  "devDependencies": {
    "@infisical/cli": "^0.44.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "oxfmt": "^0.74.0",
    "semantic-release": "^25.0.9"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@12.14.0"
}
