{
  "name": "payload-app",
  "version": "4.12.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/astro.d.ts",
      "default": "./src/index.ts"
    },
    "./word-derived": "./src/lib/wordDerived.ts",
    "./comments": "./src/lib/comments.ts",
    "./word-feedback": "./src/lib/wordFeedback.ts",
    "./bon-rules": "./src/lib/bonRules.ts",
    "./bon-player": "./src/lib/bonPlayer.ts",
    "./bon-names": "./src/lib/bonNames.ts",
    "./bon-ranking": "./src/lib/bonRanking.ts",
    "./word-stats": "./src/lib/wordStats.ts",
    "./lexical-html": "./src/lib/lexicalHtml.ts",
    "./routes": "./src/lib/routes.ts",
    "./preview": "./src/lib/preview.ts"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "bash ../scripts/with-env.sh cross-env NODE_OPTIONS=--no-deprecation sh -c 'next dev -p ${CMS_PORT:-3001}'",
    "seed:test": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seedTestword.ts",
    "dev:access": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/devAccess.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed:e2e": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/e2e.ts",
    "seed:dev": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/dev.ts",
    "verify:db": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/verifyDb.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:down": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:down",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test": "vitest run",
    "lint": "oxlint src tests --type-aware --deny-warnings --fix"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-mcp": "3.93.0",
    "@payloadcms/plugin-redirects": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "all-the-german-words": "^1.1.0",
    "cross-env": "^10.1.0",
    "de-compromise": "^0.1.2",
    "graphql": "^16.8.1",
    "hyphenation.de": "^0.2.1",
    "hypher": "^0.2.5",
    "jsdom": "^31.0.0",
    "natural": "^8.2.6",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
