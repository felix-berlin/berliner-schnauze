{
  "name": "payload-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/astro.d.ts",
      "default": "./src/index.ts"
    },
    "./word-derived": "./src/lib/wordDerived.ts",
    "./lexical-html": "./src/lib/lexicalHtml.ts",
    "./routes": "./src/lib/routes.ts",
    "./preview": "./src/lib/preview.ts"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed:e2e": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/e2e.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test": "vitest run",
    "lint": "oxlint src tests --type-aware --deny-warnings --fix"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-redirects": "3.91.0",
    "@payloadcms/plugin-seo": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "all-the-german-words": "^1.1.0",
    "cross-env": "^7.0.3",
    "de-compromise": "^0.1.1",
    "graphql": "^16.8.1",
    "hyphenation.de": "^0.2.1",
    "hypher": "^0.2.5",
    "jsdom": "^30.1.3",
    "natural": "^8.1.1",
    "next": "16.4.3",
    "nodemailer": "^10.1.1",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
