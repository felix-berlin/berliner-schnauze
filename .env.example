# WordPress MCP server (.mcp.json → berlinerSchnauze)
# Application Password: WP Profil → Application Passwords generieren, NICHT Hauptpasswort nutzen.
# Save in user settings `~/.claude/settings.json` under "env".
WP_MCP_API_URL=https://website.com/wp-json/mcp/mcp-adapter-default-server
WP_MCP_USERNAME=
WP_MCP_PASSWORD=

# Payload backend (payload/), values via Infisical or the git-ignored .env
DATABASE_URL=
DATABASE_URL_TEST=
PAYLOAD_SECRET=
PAYLOAD_SERVER_URL=
# Site the admin's preview button links to (default https://berliner-schnauze.wtf; http://localhost:4321 in dev)
SITE_URL=
MEDIA_DIR=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Astro web server runtime (on-demand routes), values via Infisical or the git-ignored .env
TURNSTILE_SECRET_KEY=
SMTP_URL=
SUGGEST_MAIL_TO=
OG_CACHE_DIR=
