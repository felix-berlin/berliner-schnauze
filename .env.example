# WordPress MCP server (.mcp.json → berlinerSchnauze)
# Application Password: WP Profil → Application Passwords generieren, NICHT Hauptpasswort nutzen.
# Save in user settings `~/.claude/settings.json` under "env".
WP_MCP_API_URL=https://website.com/wp-json/mcp/mcp-adapter-default-server
WP_MCP_USERNAME=
WP_MCP_PASSWORD=

# Runtime database connection for both application services; local fallback is the git-ignored .env
DATABASE_URL=
DATABASE_URL_TEST=
PAYLOAD_SECRET=
PAYLOAD_SERVER_URL=
# Site the admin's preview button links to (default https://berliner-schnauze.wtf; http://localhost:4321 in dev)
SITE_URL=
MEDIA_DIR=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Compose runtime secret loading (Komodo should provide the client secrets as
# secret variables; do not commit real credentials to this file).
INFISICAL_ENABLED=false
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
# Use https://eu.infisical.com for EU Cloud or your self-hosted instance URL.
INFISICAL_DOMAIN=https://infisical.kasimir.dev
INFISICAL_WEB_CLIENT_ID=
INFISICAL_WEB_CLIENT_SECRET=
INFISICAL_CMS_CLIENT_ID=
INFISICAL_CMS_CLIENT_SECRET=

# Astro web server runtime (on-demand routes), values via Infisical or the git-ignored .env
TURNSTILE_SECRET_KEY=
SMTP_URL=
SUGGEST_MAIL_TO=
OG_CACHE_DIR=
