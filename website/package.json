{
  "name": "website",
  "version": "4.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm run supportedBrowsers",
    "dev": "infisical run -- astro dev",
    "start": "astro dev",
    "build": "pnpm run supportedBrowsers && astro build",
    "build:local": "infisical run -- pnpm run build",
    "build:strict": "astro check && tsc --noEmit && vue-tsc --noEmit && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typechecking": "astro check && vue-tsc --noEmit",
    "lint": "pnpm run lint:js && pnpm run lint:style",
    "lint:js": "oxlint src/ --deny-warnings --fix --fix-suggestions",
    "lint:style": "stylelint \"**/*.{scss,sass}\" --ignore-path ../.gitignore --fix",
    "lint:report:sarif": "oxlint src/ --format=sarif > oxlint-results.sarif",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest --coverage",
    "test:unit:ui": "vitest --coverage --ui",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit",
    "vitest:update": "vitest --update",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/favicons/favicon.svg",
    "supportedBrowsers": "node scripts/generate-supported-browsers.mjs",
    "server:build:preview": "pnpm build && pnpm server:preview"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/partytown": "^2.1.8",
    "@astrojs/vue": "^7.1.1",
    "@felix_berlin/sass-butler": "4.0.0",
    "@iconify-json/lucide": "^1.2.147",
    "@nanostores/async": "^0.1.1",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/vue": "^1.1.0",
    "@orama/highlight": "^0.1.9",
    "@orama/orama": "^3.1.18",
    "@orama/stemmers": "^3.1.18",
    "@sentry/vite-plugin": "^11.8.0",
    "@spotlightjs/astro": "^3.2.6",
    "@vueform/multiselect": "^2.6.11",
    "@vueuse/core": "^15.0.0",
    "astro": "^7.4.1",
    "astro-breadcrumbs": "^3.4.2",
    "astro-matomo": "^1.12.0",
    "astro-og-canvas": "^0.13.2",
    "canvaskit-wasm": "0.42.0",
    "compromise": "^14.19.0",
    "de-compromise": "^0.1.1",
    "hyphenation.de": "^0.2.1",
    "hypher": "^0.2.5",
    "nanostores": "^1.5.5",
    "natural": "^8.1.1",
    "payload": "3.91.0",
    "payload-app": "workspace:*",
    "photoswipe": "^5.4.4",
    "virtua": "^0.53.5",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.44",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@codecov/astro-plugin": "^2.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.100",
    "@infisical/cli": "^0.44.3",
    "@nanostores/logger": "^1.1.0",
    "@playwright/test": "^1.64.1",
    "@sentry/browser": "^11.8.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/astro": "^1.2.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "@vitest/web-worker": "5.0.5",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.5.1",
    "browserslist-useragent-regexp": "^4.1.4",
    "esbuild": "^0.28.2",
    "eslint-plugin-astro": "^3.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postcss-html": "^2.0.0",
    "postcss-preset-env": "^11.6.1",
    "postcss-scss": "^4.0.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.100.00",
    "std-env": "^4.3.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
