---
import "@styles/objects/_error-page.scss";
import Layout from "@layouts/Layout.astro";

// Also when another page rewrites here (unknown slug): the middleware then marks the error page uncacheable.
Astro.response.status = 404;
---

<Layout content={{ title: "Seite konnte nicht gefunden werden" }}>
  <section class="o-error-page">
    <h1>Blöd jelaufen, die Seite gibts nicht.</h1>
  </section>
</Layout>
