---
import '@styles/plugins/astro-breadcrumbs.scss';
import '@styles/components/_magazin-article.scss';

import Layout from '@layouts/Layout.astro';
import ArticleBlocks from '@components/magazin/ArticleBlocks.astro';
import ArticleShare from '@components/magazin/ArticleShare.vue';
import { fetchAllPosts } from '@services/api.ts';
import { fetchDraftPost } from '@services/payload/posts.ts';
import { metaToSeo } from '@services/payload/seo.ts';
import { PREVIEW_CACHE_CONTROL, readPreview } from '@services/preview.ts';
import { canonicalUrl, formattedDate, seoData } from '@utils/helpers.ts';
import { processArticleBlocks } from '@utils/article.ts';
import { Breadcrumbs } from 'astro-breadcrumbs';
import ChevronRight from '~icons/lucide/chevron-right';
import { Picture } from 'astro:assets';

const { postSlug } = Astro.params;
const allPosts = await fetchAllPosts();
// An editor with a preview cookie for this post sees its latest draft.
const preview = readPreview(Astro.cookies, 'posts');
const draft = preview ? await fetchDraftPost(preview.id) : undefined;
const isPreview = draft?.slug === postSlug;
if (isPreview) Astro.response.headers.set('Cache-Control', PREVIEW_CACHE_CONTROL);
const post = isPreview ? draft : allPosts.find((p) => p.slug === postSlug);
if (!post) return Astro.rewrite('/404');

// fetchAllPosts is newest first
const related = allPosts.filter((p) => p.slug && p.slug !== post.slug).slice(0, 3);

const { blocks, toc, hasAffiliateLinks } = processArticleBlocks(post.blocks);

const seo = metaToSeo(post.meta, 'article');
const seoProps = seoData({
  seo: {
    canonical: seo.canonical ?? canonicalUrl(`/magazin/${post.slug}/`, Astro.site),
    opengraphDescription: seo.opengraphDescription ?? seo.metaDesc ?? '',
    ...(seo.opengraphImage && { opengraphImage: seo.opengraphImage }),
    opengraphType: 'article',
    title: seo.title ?? post.title,
  },
  title: post.title,
});

const articleJson = () =>
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    datePublished: post.publishedAt ?? undefined,
    headline: post.title,
    url: canonicalUrl(`/magazin/${post.slug}`, Astro.site),
  });
---

<Layout content={seoProps} contentClasses='o-magazin-article'>
  <Breadcrumbs indexText='Start' linkTextFormat='capitalized'>
    <ChevronRight height='20' slot='separator' width='20' />
  </Breadcrumbs>

  <header class='c-magazin-article__header'>
    <h1 class='c-magazin-article__title'>{post.title}</h1>
    <div class='c-magazin-article__meta'>
      {
        post.publishedAt && (
          <time class='c-magazin-article__date' datetime={post.publishedAt}>
            {formattedDate(post.publishedAt)}
          </time>
        )
      }
      <span class='c-magazin-article__reading-time'>{post.readingTime} Min Lesezeit</span>
    </div>
    {
      hasAffiliateLinks && (
        <p class='c-magazin-article__affiliate-disclosure'>
          Als Amazon-Partner verdiene ich an qualifizierten Verkäufen. Ich erhalte eine kleine
          Provision — für dich bleibt der Preis gleich.
        </p>
      )
    }
    {
      post.featuredImage?.url && (
        <Picture
          alt={post.featuredImage.alt ?? ''}
          class='c-magazin-article__image c-magazin-article__image--featured'
          fallbackFormat='webp'
          formats={['avif', 'webp']}
          height={420}
          loading='eager'
          src={post.featuredImage.url}
          width={800}
        />
      )
    }
  </header>

  <div class='c-magazin-article__layout'>
    {
      toc.length >= 3 && (
        <aside class='c-magazin-article__toc js-toc' aria-label='Inhalt'>
          <p class='c-magazin-article__toc-title'>Inhalt</p>
          <nav>
            <ol class='c-magazin-article__toc-list'>
              {toc.map((entry) => (
                <li>
                  <a class='c-magazin-article__toc-link' data-toc={entry.id} href={`#${entry.id}`}>
                    {entry.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )
    }

    <div class='c-magazin-article__main'>
      <ArticleBlocks blocks={blocks} />
    </div>
  </div>

  <footer class='c-magazin-article__footer'>
    <div class='c-magazin-article__footer-actions'>
      <a class='c-button' href='/magazin'>
        <span aria-hidden='true'>←</span> Zurück zum Magazin
      </a>
      <ArticleShare client:visible title={post.title} url={`/magazin/${post.slug}`} />
    </div>

    {
      related.length > 0 && (
        <section class='c-magazin-article__related'>
          <h2 class='c-magazin-article__related-title'>Noch nich' genug?</h2>
          <ul class='c-magazin-article__related-list'>
            {related.map((item) => (
              <li class='c-magazin-article__related-item'>
                <a class='c-magazin-article__related-link' href={`/magazin/${item.slug}`}>
                  <span class='c-magazin-article__related-headline'>{item.title}</span>
                  {item.publishedAt && (
                    <time class='c-magazin-article__related-date' datetime={item.publishedAt}>
                      {formattedDate(item.publishedAt)}
                    </time>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </footer>

  <script set:html={articleJson()} type='application/ld+json' />
</Layout>

<script>
  import { initScrollSpy } from '@utils/scrollSpy';

  // Progressive enhancement — the jump links work without this.
  const initTocSpy = () => {
    initScrollSpy({
      activeClass: 'is-current',
      getSectionId: (link) => link.dataset.toc,
      linkSelector: '[data-toc]',
      navSelector: '.js-toc',
    });
  };

  document.addEventListener('astro:page-load', initTocSpy);
</script>
