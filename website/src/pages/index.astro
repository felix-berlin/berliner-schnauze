---
import '@styles/pages/_home.scss';
import HomePoll from '@components/HomePoll.vue';
import BerlinerischArticle from '@components/home/BerlinerischArticle.astro';
import BonTeaser from '@components/home/BonTeaser.vue';
import BrowseChips from '@components/home/BrowseChips.astro';
import FaqAbout from '@components/home/FaqAbout.astro';
import FreshLists from '@components/home/FreshLists.vue';
import HomeIntro from '@components/home/HomeIntro.astro';
import HomeSearch from '@components/home/HomeSearch.vue';
import MagazineQuote from '@components/home/MagazineQuote.astro';
import ResultsBand from '@components/home/ResultsBand.vue';
import SuggestGap from '@components/home/SuggestGap.astro';
import ToGoBar from '@components/home/ToGoBar.vue';
import TopicRegister from '@components/home/TopicRegister.astro';
import WordOfTheDayStage from '@components/home/WordOfTheDayStage.vue';
import Layout from '@layouts/Layout.astro';
import { fetchHomeStatsOrNull } from '@services/homeStats.ts';
import { fetchHome } from '@services/payload/home.ts';
import { fetchAllWords } from '@services/payload/words.ts';
import { SITE_URL } from 'astro:env/client';
import { defaultOgImage } from '@utils/defaultOgImage';
import { jsonLd, seoData } from '@utils/helpers';
import { homeDescription, homeJsonLd } from '@utils/homeJsonLd';

// Old share links (/?q=…) pointed at the search that used to live here. Redirect only real page loads:
// ClientRouter fetches to / with ?q= must stay on the home page.
// 302, not 301: a browser would reuse a cached 301 for those fetches as well.
const query = Astro.url.searchParams.get('q');
if (query && Astro.request.headers.get('sec-fetch-mode') === 'navigate') {
  return new Response(null, {
    headers: {
      'Cache-Control': 'private, no-store',
      Location: `/wort?q=${encodeURIComponent(query)}`,
    },
    status: 302,
  });
}

// Stats failing must not take the page down: its sections drop (docs/design/startseite-v20/SPEC.md §13).
const [home, words, stats] = await Promise.all([
  fetchHome(),
  fetchAllWords(),
  fetchHomeStatsOrNull(),
]);

// Lemma -> slug of the published words: the intro and the article link only words that exist.
const linkable = new Map(words.map((w) => [w.berlinerisch, w.slug]));

const MIN_LIST = 3; // SPEC §19: below three entries a list drops
const popular = stats?.popular ?? [];
const rising = stats?.rising ?? [];
const showFresh = [home.newest, popular, rising].some((list) => list.length >= MIN_LIST);
const showResults =
  !!stats &&
  (stats.districts.some((d) => d.value !== null) ||
    stats.ageLists.dying.length + stats.ageLists.growing.length > 0);

const description = homeDescription(home.wordCount);
const content = {
  seo: {
    canonical: SITE_URL,
    opengraphDescription: description,
    opengraphImage: await defaultOgImage('Berliner Schnauze – Berlinerisch Wörterbuch'),
    opengraphType: 'website',
  },
  title: 'Berliner Wörterbuch – Berlinerisch auf Hochdeutsch erklärt | Berliner Schnauze',
};
Astro.cache?.set({ maxAge: 60, swr: 300 });
---

<Layout content={seoData(content)} contentClasses='o-home' footerCallout='none'>
  <Fragment slot='head'>
    {homeJsonLd(home).map((item) => <script set:html={jsonLd(item)} type='application/ld+json' />)}
  </Fragment>

  {/* Order and surfaces: SPEC §2. A section without data drops (§13); stage and search always stay. */}
  <section class='o-home-section' data-variant='stage'>
    <div class='o-home-in'>
      <HomeIntro intro={home.intro} wordCount={home.wordCount} linkable={linkable} />
      {home.word && <WordOfTheDayStage client:visible word={home.word} />}
      <HomeSearch client:load />
      <BrowseChips tryWords={home.tryWords} browseLinks={home.browseLinks} />
    </div>
  </section>

  {
    home.poll && (
      <section class='o-home-section' data-surface='card'>
        <div class='o-home-in'>
          <HomePoll
            client:visible
            lemma={home.poll.lemma}
            meaning={home.poll.meaning}
            slug={home.poll.slug}
            total={home.poll.totalVotes}
            wordId={home.poll.wordId}
          />
        </div>
      </section>
    )
  }

  {
    home.topics.length >= MIN_LIST && (
      <section class='o-home-section'>
        <div class='o-home-in'>
          <TopicRegister topics={home.topics} />
        </div>
      </section>
    )
  }

  {
    stats && (
      <section class='o-home-section' data-surface='accent'>
        <div class='o-home-in'>
          <BonTeaser
            client:visible
            steps={stats.bon.steps}
            roundsToday={stats.bon.roundsToday}
            card={stats.bon.card}
          />
        </div>
      </section>
    )
  }

  {
    showFresh && (
      <section class='o-home-section'>
        <div class='o-home-in'>
          <FreshLists client:visible newest={home.newest} popular={popular} rising={rising} />
        </div>
      </section>
    )
  }

  {
    stats && showResults && (
      <section class='o-home-section' data-surface='band'>
        <div class='o-home-in'>
          <ResultsBand client:visible districts={stats.districts} ageLists={stats.ageLists} />
        </div>
      </section>
    )
  }

  {
    home.knowledgeHtml && (
      <section class='o-home-section'>
        <div class='o-home-in'>
          <BerlinerischArticle
            knowledgeHtml={home.knowledgeHtml}
            soundRules={home.soundRules}
            wordCount={home.wordCount}
            linkable={linkable}
          />
        </div>
      </section>
    )
  }

  <section class='o-home-section' data-surface='card'>
    <div class='o-home-in'>
      <FaqAbout faq={home.faq} about={home.about} wordCount={home.wordCount} />
    </div>
  </section>

  {
    home.magazine?.quote && (
      <div class='o-home-section'>
        <MagazineQuote magazine={home.magazine} />
      </div>
    )
  }

  <section class='o-home-section'>
    <div class='o-home-in'>
      <SuggestGap gap={home.gap} />
    </div>
  </section>

  {/* ToGoBar is its own labelled section: the wrapper only paints the band and pads the sides. */}
  <div class='o-home-section' data-surface='card2' data-variant='bar'>
    <div class='o-home-in'>
      <ToGoBar client:visible />
    </div>
  </div>
</Layout>

<script>
  import { onPage } from '@utils/pageLifecycle';
  import { revealOnView } from '@utils/revealOnView';

  // Re-runs per navigation (ClientRouter); the previous page's observer goes with its DOM.
  onPage(() => revealOnView(document));
</script>
