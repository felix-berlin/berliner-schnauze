---
// Styles
import '@styles/objects/_word.scss';
import '@styles/plugins/astro-breadcrumbs.scss';

import Lightbox from '@components/word/Lightbox.vue';
import WordImages from '@components/word/WordImages.astro';
import { getImage } from 'astro:assets';
import { toWordImages } from '@utils/wordImages.ts';
import WordHero from '@components/word/WordHero.astro';
import WordOfflineBanner from '@components/word/WordOfflineBanner.vue';
import WordLearnMore from '@components/word/WordLearnMore.astro';
import WordComments from '@components/comments/WordComments.vue';
import WordFeedbackCard from '@components/word-feedback/WordFeedbackCard.vue';
import WordPageFooter from '@components/word/WordPageFooter.astro';
import WordAudio from '@components/word/WordAudio.vue';
import WordTrendBox from '@components/word/WordTrendBox.astro';
import WordSectionBeispiele from '@components/word/WordSectionBeispiele.astro';
import WordSectionEtymologie from '@components/word/WordSectionEtymologie.astro';
import BookShelf from '@components/word/BookShelf.astro';
import NextLinks from '@components/word/NextLinks.astro';
import WordNeighborhood from '@components/word/WordNeighborhood.astro';
import WordAnalysis from '@components/word/WordAnalysis.astro';
import WordSidebar from '@components/word/WordSidebar.astro';
import WordTabBar from '@components/word/WordTabBar.vue';
import Layout from '@layouts/Layout.astro';
import { fetchAffiliateData } from '@services/payload/site.ts';
import { fetchDraftWord, fetchWordBySlug, translationTexts } from '@services/payload/words.ts';
import { voiceSources } from '@composables/useVoicePlayer.ts';
import { getWordTrend } from '@services/payload/wordTrend.ts';
import { fetchWordRefs, toWordRef } from '@services/payload/wordRefs.ts';
import { metaToSeo } from '@services/payload/seo.ts';
import { previewDraft } from '@services/preview.ts';
import { escapeHtml } from 'payload-app/lexical-html';
import { seoData, canonicalUrl, jsonLd } from '@utils/helpers.ts';
import { buildWordSections, hasOrigin } from '@utils/wordSections.ts';
import { hasNeighborhood } from '@utils/wordNeighborhood.ts';
import { resolvePos } from '@utils/wordPos.ts';
import {
  alphabeticNeighbors,
  findAnagrams,
  similarSoundingWords,
  similarWords,
} from '@utils/wordHelper.ts';
import { Breadcrumbs } from 'astro-breadcrumbs';
import { wordSeoDescription, wordSeoTitle } from 'payload-app/routes';
import ChevronRight from '~icons/lucide/chevron-right';


const { wordSlug } = Astro.params;
// An editor with a preview cookie for this word sees its latest draft.
const draft = await previewDraft(Astro, 'words', wordSlug, fetchDraftWord);
const word = draft ?? (wordSlug ? await fetchWordBySlug(wordSlug) : undefined);
if (!word) return Astro.rewrite('/404');

// Top 10 of the week; a draft preview has no public numbers.
const trend = draft ? undefined : await getWordTrend(word.id);
const wordRef = toWordRef(word);
const wordRefs = await fetchWordRefs();

// Derived from the memoized refs of all words (~6000, rebuilt when a word changes); indexes are cached per refs array.
const alphabeticNeighborsResult = alphabeticNeighbors(wordRefs, wordRef);
const anagramsResult = findAnagrams(word.berlinerisch, wordRefs);
const similarSpellingResult = similarWords(wordRefs, wordRef, 0.85)
  .toSorted((a, b) => b.isSimilar - a.isSimilar)
  .slice(0, 5)
  .map((w) => w.word);
const soundingWordsResult = similarSoundingWords(wordRefs, wordRef);

const { berlinerisch } = word;
const translations = translationTexts(word);
const dateCreated = word.publishedAt ?? null;
const dateModified = word.contentModifiedAt ?? null;

const wordSeoFacts = {
  berlinerisch,
  example: word.examples.find((e) => e.example)?.example,
  hasAudio: word.berlinerischAudio.length > 0,
  hasEtymology: word.hasInfoText,
  hasExamples: word.examples.some((e) => e.example),
  translations,
};
const wordDescription = wordSeoDescription(wordSeoFacts) || undefined;
const wordPageTitle = wordSeoTitle(wordSeoFacts);

const wordTags = word.derived.nlpTags;

const wordImages = toWordImages(word.images, word.berlinerisch);
const hasImages = wordImages.length > 0;
// Large version for the lightbox (the strip/hero sizes come from WordImages).
const lightboxImages = await Promise.all(
  wordImages.map(async ({ alt, credit, height, src, width }) => {
    const target = Math.min(1600, width); // never upscale a smaller source
    return { alt, credit, src: (await getImage({ format: 'webp', height: Math.round((target * height) / width), src, width: target })).src };
  }),
);
const { books: affiliateBooks, disclaimers: affiliateDisclaimers } = await fetchAffiliateData();
// An editor-set word type wins; otherwise the automatic guess, marked as such in the hero.
const wordPos = resolvePos(word.wordTypes[0]?.name, wordTags);

const neighborhood = {
  after: alphabeticNeighborsResult.after,
  before: alphabeticNeighborsResult.before,
  // Already in the analysis band: not repeated in the Umfeld card.
  exclude: [...soundingWordsResult, ...similarSpellingResult].map((w) => w.slug),
  related: word.relatedWords,
  word: berlinerisch,
};

const sections = buildWordSections({
  draft: !!draft,
  hasExamples: wordSeoFacts.hasExamples,
  hasNeighborhood: hasNeighborhood(neighborhood),
  hasOrigin: hasOrigin(word),
});

const firstImage = word.images[0];
const voices = voiceSources(word.berlinerischAudio);
const firstAudio = word.berlinerischAudio[0];
const seo = metaToSeo(word.meta, 'article');

const generatedOgImageUrl = new URL(`/og/${wordSlug}.png`, Astro.site).toString();

const ogImage = seo.opengraphImage
  ? seo.opengraphImage
  : firstImage
    ? {
        alt: firstImage.alt || berlinerisch,
        height: firstImage.height ? String(firstImage.height) : undefined,
        sourceUrl: firstImage.url,
        width: firstImage.width ? String(firstImage.width) : undefined,
      }
    : {
        // The generated card shows the word and its first meaning: say both.
        alt: translations[0] ? `${berlinerisch} auf Berlinerisch: ${translations[0]}` : berlinerisch,
        height: '630',
        sourceUrl: generatedOgImageUrl,
        width: '1200',
      };

const exampleComments = word.examples
  .filter((e) => Boolean(e.example))
  .map((e) => {
    const comment: { '@type': string; text: string; description?: string } = {
      '@type': 'Comment',
      text: e.example as string,
    };
    if (e.exampleExplanation) {
      comment.description = e.exampleExplanation;
    }
    return comment;
  });

const schemaJson = () => {
  const alternateNames = (word.alternativeWords ?? [])
    .map((w) => w.alternativeWord)
    .filter((n): n is string => Boolean(n));

  return jsonLd({
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    ...(alternateNames.length > 0 && { alternateName: alternateNames }),
    ...(exampleComments.length > 0 && { comment: exampleComments }),
    ...(dateCreated && { dateCreated }),
    ...(dateModified && { dateModified }),
    description: wordDescription ?? translations.join('; '),
    ...(word.article && {
      disambiguatingDescription: `Berliner Dialektwort, ${word.article}`,
    }),
    identifier: canonicalUrl(Astro.url.pathname, Astro.site),
    // Described here, not only referenced: Google does not resolve an @id that another page defines.
    publisher: {
      '@id': `${Astro.site}#organization`,
      '@type': 'Organization',
      name: 'Berliner Schnauze',
      url: String(Astro.site),
    },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: [
        '.c-word-hero h1',
        '.c-word-meanings .t-em',
        // Only rendered with examples: a selector that matches nothing is noise.
        ...(exampleComments.length > 0 ? ['.c-word-examples__text'] : []),
      ],
    },
    ...(firstImage && {
      image: {
        '@type': 'ImageObject',
        contentUrl: firstImage.url,
        url: firstImage.url,
        ...(firstImage.alt && { name: firstImage.alt }),
        ...(firstImage.caption && { caption: escapeHtml(firstImage.caption) }),
        ...(firstImage.width && { width: firstImage.width }),
        ...(firstImage.height && { height: firstImage.height }),
      },
    }),
    inDefinedTermSet: {
      '@id': `${canonicalUrl('/wort', Astro.site)}#termset`,
      '@type': 'DefinedTermSet',
      description: 'Wörterbuch für den Berliner Dialekt und Berliner Schnauze',
      inLanguage: 'de-DE',
      name: 'Berliner Schnauze Wörterbuch',
      url: canonicalUrl('/wort', Astro.site),
    },
    inLanguage: 'de-DE',
    mainEntityOfPage: canonicalUrl(Astro.url.pathname, Astro.site),
    name: berlinerisch,
    sameAs: word.learnMore || undefined,
    ...(firstAudio && {
      subjectOf: {
        '@type': 'AudioObject',
        contentUrl: firstAudio.audio.url,
        description: `Berliner Aussprache von „${berlinerisch}"`,
        encodingFormat: firstAudio.audio.mimeType || undefined,
        inLanguage: 'de-DE',
        name: `Aussprache: ${berlinerisch}`,
      },
    }),
    termCode: word.slug,
    url: canonicalUrl(Astro.url.pathname, Astro.site),
  });
};
---

<Layout
  content={seoData({
    seo: {
      // An editor-set SEO title/description (CMS) wins over the generated ones.
      ...(wordDescription && { opengraphDescription: wordDescription }),
      ...seo,
      title: seo.title ?? wordPageTitle,
      ...(ogImage && { opengraphImage: ogImage }),
      ...(dateCreated && { opengraphPublishedTime: dateCreated }),
      ...(dateModified && { opengraphModifiedTime: dateModified }),
    },
    title: berlinerisch,
  })}
  contentClasses='o-word'
>
  <Fragment slot='head'>
    <script set:html={schemaJson()} type='application/ld+json' />
  </Fragment>

  <WordOfflineBanner client:load />

  <nav class='o-page-topbar' aria-label='Brotkrümelpfad'>
    <Breadcrumbs indexText='Start' linkTextFormat='capitalized' truncated={true}>
      <ChevronRight height='20' slot='separator' width='20' />
    </Breadcrumbs>
  </nav>

  <article class='o-word-page' data-pulse-word={draft ? undefined : word.id}>
    <WordTabBar client:load sections={sections} />
    <WordSidebar posLabel={wordPos?.pos} sections={sections} word={word} />

    <div class='o-word-main'>
      <WordHero images={wordImages} learnMore={word.learnMore} word={word} pos={wordPos?.pos} posAuto={wordPos?.auto} meanings={translations} draft={!!draft} trend={trend} />

      {hasImages && <WordImages images={wordImages} learnMore={word.learnMore} placement='strip' />}
      {/* Only the lightbox needs JS: the strip is server-rendered, its buttons open the dialog once this hydrates. */}
      {hasImages && <Lightbox client:idle images={lightboxImages} />}

      <div class='o-word-main-content'>
        {trend && <WordTrendBox {...trend} />}

        {/* client:visible: the row sits right under the hero, but nothing needs JS before a click and the buttons are server-rendered. */}
        {(voices.m || voices.w) && <WordAudio client:visible sources={voices} wordId={draft ? undefined : word.id} />}

        {!draft && (
          <div id='sagste-det-noch'>
            <WordFeedbackCard client:visible wordId={word.id} />
          </div>
        )}

        <WordSectionEtymologie word={word} />

        <WordSectionBeispiele examples={word.examples} />

        <WordAnalysis
          allWords={wordRefs}
          anagrams={anagramsResult}
          parts={word.derived.decomposition ?? []}
          pos={wordPos?.pos}
          similarSpelling={similarSpellingResult}
          soundingWords={soundingWordsResult}
          word={berlinerisch}
          wordTags={wordTags}
        />

        {!hasImages && word.learnMore && <WordLearnMore learnMore={word.learnMore} />}

        <BookShelf books={affiliateBooks} disclaimers={affiliateDisclaimers} />

        <WordNeighborhood {...neighborhood} />

        {!draft && (
          <div id='kommentare'>
            <WordComments client:visible wordId={word.id} />
          </div>
        )}

        <NextLinks trending={!!trend} words={wordRefs} />

        <WordPageFooter publishedAt={word.publishedAt} modifiedAt={word.contentModifiedAt} />
      </div>

    </div>
  </article>

</Layout>

<script>
  import { reportWord } from '@utils/wordPulse.ts';

  // Draft previews carry no data-pulse-word and are never reported. The #verwandte list
  // (WordNeighborhood) is replaced on every navigation, so its listener cannot pile up.
  document.addEventListener('astro:page-load', () => {
    const id = Number(document.querySelector<HTMLElement>('[data-pulse-word]')?.dataset.pulseWord);
    if (!id) return;
    reportWord(id, 'view');
    document.getElementById('verwandte')?.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) reportWord(id, 'click');
    });
  });
</script>

<script>
  // The comments island hydrates only when visible; a comment link brings it into view, it then scrolls to the card.
  document.addEventListener('astro:page-load', () => {
    if (/^#kommentar-\d+$/.test(location.hash))
      document.getElementById('kommentare')?.scrollIntoView();
  });
</script>
