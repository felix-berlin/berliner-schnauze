---
import SearchPage from "@components/search/SearchPage.astro";
import { runSearch } from "@lib/search/run";
import { parseState } from "@lib/search/url";
import { BEZIRK_NAMES } from "@lib/bezirkNames";
import { getServerWordDb } from "@services/serverWordDb.ts";
import { fetchAllThemen } from "@services/payload/themen.ts";
import { getTrendRanks } from "@services/payload/trending.ts";
import { pickWordOfTheDay } from "@utils/wordOfTheDay.ts";

// Awaiting here holds back the shell; the data is memoized (60 s / 5 min), so only the first request per window pays.
const [{ db, entries }, themen, trendRanks] = await Promise.all([
  getServerWordDb(),
  fetchAllThemen(),
  getTrendRanks(),
]);

const pos = [...new Set(entries.flatMap((e) => e.berlinerischWordTypes))].sort((a, b) =>
  a.localeCompare(b, "de"),
);
const areas = Object.entries(BEZIRK_NAMES).map(([key, name]) => ({ key, name }));
const themes = themen.map(({ name, slug }) => ({ name, slug }));

const state = parseState(Astro.url.searchParams, {
  areas: areas.map((a) => a.key),
  pos,
  themes: themes.map((t) => t.slug),
});
const ctx = { trendRanks, wotd: pickWordOfTheDay(entries, new Date())?.slug };
const result = await runSearch(db, entries, state, ctx);

const LETTERS = [..."ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÜ"];
const meta = {
  areas,
  letters: LETTERS.map((letter) => ({ count: result.facets.letters[letter] ?? 0, letter })),
  pos,
  themes,
  totalWords: entries.length,
};

Astro.cache?.set({ maxAge: 60, swr: 300 });
---

<SearchPage {ctx} {meta} {result} {state} />
