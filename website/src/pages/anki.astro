---
import '@styles/components/_button.scss';
// Polar-Checkout-Link. Solange nicht gesetzt, wird kein Kauf-Button gezeigt.
import { ANKI_DECK_FULL_CHECKOUT, SITE_URL } from 'astro:env/client';
import { fetchAllWords, translationTexts } from '@services/payload/words.ts';
import { fetchAnkiContent } from '@services/payload/site.ts';
import { getPolarFullDeckPrice, getPolarFullDeckPriceAmount } from '@services/polar.ts';
import { getLiteDeckDownloadUrl } from '@services/githubRelease.ts';
import { routeToWord, shuffle, jsonLd } from '@utils/helpers.ts';
import { stripTags } from '@utils/article.ts';
import Layout from '@layouts/Layout.astro';
import { defaultOgImage } from '@utils/defaultOgImage';
import AnkiFlashcardDemo from '@components/anki/AnkiFlashcardDemo.vue';
import AnkiLetterCoverage from '@components/anki/AnkiLetterCoverage.vue';
import AnkiFaq from '@components/anki/AnkiFaq.vue';
import AnkiDevHours from '@components/anki/AnkiDevHours.astro';
import Layers from 'virtual:icons/lucide/layers';
import ArrowUpRight from 'virtual:icons/lucide/arrow-up-right';
import Download from 'virtual:icons/lucide/download';
import Globe from 'virtual:icons/lucide/globe';
import Plus from 'virtual:icons/lucide/plus';
import FolderGit2 from 'virtual:icons/lucide/folder-git-2';
import RefreshCw from 'virtual:icons/lucide/refresh-cw';
import Windows from 'virtual:icons/mdi/microsoft-windows';
import Apple from 'virtual:icons/simple-icons/apple';
import Linux from 'virtual:icons/simple-icons/linux';
import Android from 'virtual:icons/simple-icons/android';


const page = {
  seo: {
    opengraphDescription:
      'Berlinerisch lernen mit Anki: Lite-Deck kostenlos laden oder das komplette Full-Deck mit allen Wörtern und Beispielen kaufen. Einmal zahlen, Updates inklusive.',
    opengraphImage: await defaultOgImage('Berliner Schnauze – Anki-Deck zum Berlinerisch lernen'),
    opengraphType: 'website',
  },
  title: 'Berlinerisch lernen: Anki-Karteikarten - Berliner Schnauze',
};

const [LITE_URL, allWords, PRICE, PRICE_AMOUNT] = await Promise.all([
  getLiteDeckDownloadUrl(),
  fetchAllWords(),
  getPolarFullDeckPrice(),
  getPolarFullDeckPriceAmount(),
]);
// Gleicher Filter wie `is_publishable()` in scripts/build_anki_decks.py: Titel und mindestens eine
// Übersetzung (nach dem Entfernen von HTML). Das Deck holt nur PUBLISH-Wörter; mit SHOW_TEST_DATA
// enthält `allWords` auch Entwürfe, die Zahlen gelten dann nur näherungsweise.
const deckWords = allWords.filter(
  (w) =>
    stripTags(w.berlinerisch).trim() !== '' &&
    translationTexts(w).some((t) => stripTags(t).trim() !== ''),
);
const TOTAL_WORDS = deckWords.length;

// Gleiche Gruppierung wie `group` in scripts/build_anki_decks.py: abgeleitete wordGroup, leer -> Sonstige.
const wordsPerLetter = Object.groupBy(
  deckWords,
  (w) => w.derived.wordGroup.trim().toUpperCase() || 'Sonstige',
);
const LETTER_COUNTS = Object.fromEntries(
  Object.entries(wordsPerLetter).map(([letter, words]) => [letter, words?.length ?? 0]),
);
const LETTERS = Object.keys(LETTER_COUNTS)
  .filter((l) => l !== 'Sonstige')
  .sort((a, b) => a.localeCompare(b, 'de'));
// Gleiche Auswahl wie `select_lite()` in scripts/build_anki_decks.py: max(1, ceil(10 %)) pro Buchstabe.
const LITE_WORDS = Object.values(wordsPerLetter).reduce(
  (sum, words) => sum + Math.max(1, Math.ceil((words?.length ?? 0) / 10)),
  0,
);

// Ohne Preis (kein Token) kein Product-Markup.
const productSchema =
  PRICE_AMOUNT !== undefined &&
  jsonLd({
    '@context': 'https://schema.org',
    '@type': 'Product',
    brand: { '@type': 'Brand', name: 'Berliner Schnauze' },
    description:
      'Alle Berlinerisch-Wörter mit Übersetzung, Beispielen und Alternativwörtern als Anki-Karteikarten-Deck.',
    name: 'Berliner Schnauze Anki-Deck (Full)',
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      price: PRICE_AMOUNT.toFixed(2),
      priceCurrency: 'EUR',
      url: `${SITE_URL}/anki`,
    },
  });

const fmt = (n: number) => n.toLocaleString('de-DE');

// Demo-Karten: Wörter mit Übersetzung und Beispielsatz, pro Aufruf zufällig gezogen.
const DEMO_CARDS = shuffle(
  deckWords.flatMap((w) => {
    const example = stripTags(w.examples[0]?.example ?? '');
    const texts = translationTexts(w);
    if (!example || texts.length === 0) return [];
    return [
      {
        example,
        href: routeToWord(w.slug),
        meaning: texts.slice(0, 2).map(stripTags).join(', '),
        title: w.berlinerisch,
      },
    ];
  }),
).slice(0, 6);

const intervals = ['Heute', '1 Tag', '3 Tage', '1 Woche', '3 Wochen', '2 Monate'];

const platforms = [
  { icons: [Windows, Apple, Linux], meta: 'Windows, macOS, Linux', name: 'Anki Desktop' },
  { icons: [Android], meta: 'Android', name: 'AnkiDroid' },
  { icons: [Apple], meta: 'iPhone & iPad', name: 'AnkiMobile' },
  { icons: [Globe], meta: 'Im Browser & Sync', name: 'AnkiWeb' },
];

const { faqs, fullFeatures, liteFeatures, steps } = await fetchAnkiContent({
  liteWords: fmt(LITE_WORDS),
  totalWords: fmt(TOTAL_WORDS),
});
---

<Layout content={page}>
  <Fragment slot='head'>
    {productSchema && <script set:html={productSchema} type='application/ld+json' />}
  </Fragment>
  <div class='o-anki'>
    <!-- HERO -->
    <section class='o-anki-section o-anki-hero' aria-labelledby='anki-hero-title'>
      <div class='c-anki-heading' data-variant='hero'>
        <div class='eyebrow'>
          <Layers width='18' height='18' />
          <span>Neu ᛫ Dit Anki-Deck</span>
        </div>
        <h1 id='anki-hero-title' class='title'>
          Jeden Tag 'n paar Karten. Bald quatschst Du wie'n Ur-Berliner.
        </h1>
        <p class='lead'>
          Der Berliner-Jargon als Karteikarten für Anki. Fang kostenlos mit der <strong>Lite</strong
          >
          an — und wenn Du Blut geleckt hast, holst Du Dir die <strong>Full</strong> mit dem kompletten
          Wortschatz. Ohne Neuanfang, ohne Dopplungen.
        </p>
        <div class='actions'>
          {
            ANKI_DECK_FULL_CHECKOUT && (
              <a
                class='c-button' data-variant='primary center-icon raised'
                href={ANKI_DECK_FULL_CHECKOUT} data-track='Click Buy Full|hero'
                target='_blank'
                rel='noopener'
              >
                <span>Full-Deck kaufen{PRICE && ` ᛫ ${PRICE}`}</span>
                <ArrowUpRight width='20' height='20' />
              </a>
            )
          }
          {
            LITE_URL && (
              <a class='c-button' data-variant='paper center-icon' href={LITE_URL} data-track='Download Lite|hero' download>
                <Download width='20' height='20' />
                <span>Lite kostenlos laden</span>
              </a>
            )
          }
        </div>
        <div class='meta'>
          <span>{fmt(TOTAL_WORDS)} Wörter in der Full</span>
          <span>᛫</span>
          <span>Lite: {fmt(LITE_WORDS)} Wörter quer durch A–Z</span>
        </div>
      </div>

      <AnkiFlashcardDemo cards={DEMO_CARDS} client:visible />
    </section>

    <!-- WAS IST ANKI -->
    <section
      id='anki'
      class='o-anki-section o-anki-band'
      aria-labelledby='anki-explainer-title'
    >
      <div class='o-anki-intro'>
        <div class='c-anki-heading'>
          <div class='eyebrow'>Für alle, die's nich kennen</div>
          <h2 id='anki-explainer-title' class='title'>Wat is'n eigentlich Anki?</h2>
        </div>
        <div class='c-anki-heading' data-variant='intro'>
          <p class='lead'>
            Anki ist eine kostenlose Karteikarten-App. Der Clou: Sie merkt sich, was Du schon kannst
            und was nicht — und zeigt Dir jede Karte genau dann wieder, <strong
              >kurz bevor Du sie vergessen würdest</strong
            >. Das nennt sich verteilte Wiederholung (Spaced Repetition). Ein paar Minuten am Tag
            reichen, und die Wörter bleiben hängen.
          </p>
        </div>
      </div>

      <div class='c-anki-steps'>
        {
          steps.map((s) => (
            <div class='step'>
              <div class='head'>
                <span class='num'>{s.num}</span>
                <h3 class='title'>{s.title}</h3>
              </div>
              <p class='text'>{s.text}</p>
            </div>
          ))
        }
      </div>

      <div class='c-anki-timeline'>
        <div class='head'>
          <h3 class='title'>Wat Du gut kannst, siehste immer seltener</h3>
          <span class='caption'>Beispielhafte Abstände bei „Gut“</span>
        </div>
        <div class='row'>
          <div class='line'></div>
          {
            intervals.map((iv) => (
              <div class='point'>
                <span class='dot' />
                <span class='label'>{iv}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class='c-anki-platforms'>
        <div class='head'>
          <div class='c-anki-heading' data-variant='card'>
            <div class='eyebrow'>Läuft überall</div>
            <h3 class='title'>Lern am Schreibtisch, wiederhol in der U-Bahn.</h3>
          </div>
          <div class='c-anki-heading' data-variant='loose'>
            <p class='lead'>
              Anki gibt's für Rechner, Handy und Browser. Mit einem AnkiWeb-Konto synchronisiert sich
              Dein Lernstand zwischen allen Geräten — Du machst einfach da weiter, wo Du uffgehört
              hast.
            </p>
            <div class='cta'>
              <a
                class='c-button' data-variant='paper center-icon'
                href='https://apps.ankiweb.net/'
                data-track='Click Anki App|download'
                target='_blank'
                rel='noopener'
              >
                <Download width='20' height='20' /><span>Anki herunterladen</span>
                <ArrowUpRight width='18' height='18' />
              </a>
            </div>
          </div>
        </div>
        <div class='tiles'>
          {
            platforms.map(({ icons, name, meta }) => (
              <a
                class='tile'
                href='https://apps.ankiweb.net/'
                data-track={`Click Anki App|${name}`}
                target='_blank'
                rel='noopener'
              >
                <div class='icons'>
                  {icons.map((Icon) => (
                    <Icon width='28' height='28' />
                  ))}
                </div>
                <div class='name'>{name}</div>
                <div class='meta'>{meta}</div>
              </a>
            ))
          }
        </div>
        <div class='foot'>
          <RefreshCw width='16' height='16' />
          <span>Ein Lernstand, alle Geräte ᛫ Sync über AnkiWeb</span>
        </div>
      </div>
    </section>

    <!-- LITE VS FULL -->
    <section id='preise' class='o-anki-section' aria-labelledby='anki-pricing-title'>
      <div class='c-anki-heading' data-variant='narrow'>
        <div class='eyebrow'>Lite oder Full</div>
        <h2 id='anki-pricing-title' class='title'>
          Erst mal reinschnuppern — oder gleich ditt volle Programm.
        </h2>
      </div>

      <div class='o-anki-plans'>
        <div class='c-anki-plan'>
          <div class='head'>
            <h3 class='name'>Lite</h3>
            <div class='price'>
              <strong>0 €</strong><span>direkt hier laden</span>
            </div>
          </div>
          <ul class='features'>
            {liteFeatures.map((f) => <li>{f}</li>)}
          </ul>
          <div class='cta'>
            {
              LITE_URL ? (
                <a class='c-button' data-variant='paper center-icon' href={LITE_URL} data-track='Download Lite|pricing' download>
                  <Download width='20' height='20' /><span>Lite runterladen (.apkg)</span>
                </a>
              ) : (
                <span class='note'>Download derzeit nicht verfügbar.</span>
              )
            }
            <span class='note'>
              Datei doppelklicken — Anki importiert das Deck automatisch. Kostenlos und ohne
              Anmeldung.
            </span>
          </div>
        </div>

        <div class='c-anki-plan' data-variant='full'>
          <span class='badge'>Dit volle Programm</span>
          <div class='head'>
            <h3 class='name'>Full</h3>
            <div class='price'>
              {PRICE && <strong>{PRICE}</strong>}<span>einmalig ᛫ Updates inklusive</span>
            </div>
          </div>
          <ul class='features'>
            {fullFeatures.map((f) => <li>{f}</li>)}
          </ul>
          <div class='cta'>
            {
              ANKI_DECK_FULL_CHECKOUT ? (
                <a
                  class='c-button' data-variant='primary center-icon'
                  href={ANKI_DECK_FULL_CHECKOUT} data-track='Click Buy Full|pricing'
                  target='_blank'
                  rel='noopener'
                >
                  <span>Full-Deck kaufen{PRICE && ` ᛫ ${PRICE}`}</span>
                  <ArrowUpRight width='20' height='20' />
                </a>
              ) : (
                <span class='note'>Kommt bald.</span>
              )
            }
            <span class='note'>
              Sichere Bezahlung über Polar — Du wirst weitergeleitet. Damit unterstützt Du ein
              Open-Source-Projekt.
            </span>
          </div>
        </div>
      </div>

      <AnkiLetterCoverage
        letters={LETTERS}
        letterCounts={LETTER_COUNTS}
        liteWords={LITE_WORDS}
        totalWords={TOTAL_WORDS}
        client:visible
      />
    </section>

    <!-- UPGRADE -->
    <section class='o-anki-section o-anki-split' aria-labelledby='anki-upgrade-title'>
      <div class='c-anki-heading' data-variant='loose sm'>
        <div class='eyebrow'>Klein anfangen, später uffstocken</div>
        <h2 id='anki-upgrade-title' class='title'>
          Mit Lite loslegen — die Full passt nahtlos drauf.
        </h2>
        <p class='lead'>
          Du musst Dich nich gleich entscheiden. Lern mit der Lite, so lange Du willst. Wenn Du
          später die Full importierst, erkennt Anki die Karten, die Du schon hast: Dein
          Lernfortschritt bleibt, doppelte Karten gibt's keine — nur die fehlenden Wörter kommen
          dazu.
        </p>
      </div>
      <div class='c-anki-upgrade'>
        <div class='row'>
          <div class='row-head'>
            <strong>Deine Lite</strong><span>{fmt(LITE_WORDS)} Karten ᛫ Fortschritt bleibt</span>
          </div>
          <div class='bar'>
            <div class='learned'></div>
            <div class='rest'></div>
          </div>
        </div>
        <div class='plus'>
          <Plus width='18' height='18' /><span>Full importieren</span>
        </div>
        <div class='row'>
          <div class='row-head'>
            <strong>Danach</strong><span>{fmt(TOTAL_WORDS)} Karten ᛫ 0 Dopplungen</span>
          </div>
          <div class='bar'>
            <div class='learned'></div>
            <div class='new'></div>
          </div>
          <div class='legend'>
            <span class='item'
              ><span class='swatch' data-kind='learned'></span> schon gelernt</span
            >
            <span class='item'
              ><span class='swatch' data-kind='new'></span>{fmt(TOTAL_WORDS - LITE_WORDS)} neue
              Wörter</span
            >
          </div>
        </div>
      </div>
    </section>

    <!-- OPEN SOURCE -->
    <section class='o-anki-section o-anki-split' aria-labelledby='anki-opensource-title'>
      <div class='c-anki-heading' data-variant='loose sm'>
        <div class='eyebrow'>Open Source</div>
        <h2 id='anki-opensource-title' class='title'>
          Dein Kauf hält die Schnauze am Laufen.
        </h2>
        <p class='lead'>
          Berliner Schnauze ist ein Open-Source-Projekt — der komplette Code liegt offen auf GitHub.
          Mit der Full unterstützt Du direkt die Weiterentwicklung: neue Wörter, neue Features,
          Server und viele Stunden Arbeit nach Feierabend.
        </p>
        <div class='cta'>
          <a
            class='c-button' data-variant='paper center-icon'
            href='https://github.com/felix-berlin/berliner-schnauze'
            data-track='Click GitHub|anki'
            target='_blank'
            rel='noopener'
          >
            <FolderGit2 width='20' height='20' /><span>Quellcode auf GitHub</span>
          </a>
        </div>
      </div>
      <AnkiDevHours />
    </section>

    <!-- FAQ -->
    <section class='o-anki-section o-anki-band o-anki-faq' aria-labelledby='anki-faq-title'>
      <div class='o-anki-faq-inner'>
        <div class='c-anki-heading' data-variant='sm'>
          <h2 id='anki-faq-title' class='title'>Noch Fragen, wa?</h2>
        </div>
        <AnkiFaq faqs={faqs} />
      </div>
    </section>
  </div>

  <!-- FINAL CTA -->
  <section
    slot='footer-farewell'
    class='o-anki-farewell'
    aria-labelledby='anki-final-title'
  >
    <div class='c-anki-heading' data-variant='loose'>
      <h2 id='anki-final-title' class='title'>Na los, ab uff die Karten.</h2>
      <p class='lead'>
        {fmt(TOTAL_WORDS)} Wörter Berliner Schnauze{PRICE && ` für ${PRICE}`}. Weniger als 'ne
        Currywurst mit Pommes — und neue Wörter kriegste ohne Aufpreis nachgeliefert.
      </p>
      <div class='actions'>
        {
          ANKI_DECK_FULL_CHECKOUT && (
            <a
              class='c-button' data-variant='primary center-icon raised'
              href={ANKI_DECK_FULL_CHECKOUT} data-track='Click Buy Full|farewell'
              target='_blank'
              rel='noopener'
            >
              <span>Full-Deck kaufen{PRICE && ` ᛫ ${PRICE}`}</span>
              <ArrowUpRight width='20' height='20' />
            </a>
          )
        }
        {
          LITE_URL && (
            <a class='c-button' data-variant='paper center-icon' href={LITE_URL} data-track='Download Lite|farewell' download>
              <Download width='20' height='20' /><span>Erst mal Lite</span>
            </a>
          )
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  import { trackEvent } from '@utils/analytics';

  // Ein Listener für alle Klicks mit `data-track="Aktion|Name"` (auch in Vue-Inseln) und die
  // FAQ-Fragen (statisches <details>, ohne Hydration). Klick auf <summary> kommt vor dem
  // Toggle: ein noch geschlossenes <details> öffnet sich gerade.
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    const track = target.closest<HTMLElement>('[data-track]')?.dataset.track;
    if (track) return trackEvent('Anki', ...(track.split('|') as [string, string]));

    const summary = target.closest<HTMLElement>('.c-anki-faq summary');
    if (summary && !(summary.parentElement as HTMLDetailsElement).open) {
      trackEvent('Anki', 'FAQ Open', (summary.textContent ?? '').trim());
    }
  });
</script>

<style lang='scss' is:global>
  @use '@styles/pages/anki';
  @use '@styles/components/anki-heading';
  @use '@styles/components/anki-steps';
  @use '@styles/components/anki-timeline';
  @use '@styles/components/anki-platforms';
  @use '@styles/components/anki-plan';
  @use '@styles/components/anki-upgrade';
</style>
