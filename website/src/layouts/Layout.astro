---
import '@styles/app.scss';
import type { SeoProps } from '@components/BaseHead.astro';

import BaseHead from '@components/BaseHead.astro';
import SiteFooter from '@components/footer/SiteFooter.astro';
import MainHeader from '@components/header/MainHeader.astro';
import Modal from '@components/Modal.vue';
import ScrollToTop from '@components/ScrollToTop.vue';
import ToastNotifyContainer from '@components/toast/ToastNotifyContainer.vue';

export interface DefaultLayoutProps {
  bodyClasses?: Array<string> | string;
  content: {
    seo?: SeoProps;
    title: string;
  };
  contentClasses?: Array<string> | string;
  /** Closing callout above the footer: 'app' (install, where possible; default) or 'keiner'. A `footer-aufruf` slot wins. */
  footerAufruf?: 'app' | 'keiner';
  /** Slug of the page's own word, kept off the footer's word sign. */
  footerExcludeSlug?: string;
}

const {
  bodyClasses,
  content: { seo, title },
  contentClasses,
  footerAufruf = 'app',
  footerExcludeSlug,
} = Astro.props as DefaultLayoutProps;

const footerMode = Astro.slots.has('footer-aufruf')
  ? 'callout'
  : footerAufruf === 'keiner'
    ? 'sign'
    : 'app';

---

<!doctype html>
<html lang='de'>
  <head>
    <BaseHead seo={seo} title={title} />

    <slot name='head' />
  </head>
  <body class='o-body' class:list={bodyClasses}>
    <MainHeader transition:persist />
    <main class='o-content u-max-body-width' class:list={contentClasses}>
      <div id='docStart' style='position: absolute'></div>
      <slot />
    </main>
    <ScrollToTop client:idle />
    <ToastNotifyContainer client:only='vue' />
    <Modal client:idle />
    <SiteFooter excludeSlug={footerExcludeSlug} mode={footerMode}>
      <slot name='footer-aufruf' slot='aufruf' />
    </SiteFooter>
  </body>
</html>

<script>
  import { initHistoryNavigationFallback } from '@utils/historyNavigationFallback';
  import { initWordLoading } from '@utils/wordLoading';

  // Intentionally NOT wrapped in astro:page-load: the popstate listener must
  // attach exactly once per tab session, not re-attach on every transition.
  initHistoryNavigationFallback();
  // Same for the word page loading skeleton: one pair of listeners per tab session.
  initWordLoading();
</script>
