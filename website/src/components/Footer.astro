---
import CarbonBadge from '@components/CarbonBadge.vue';
import FooterAppSection from '@components/FooterAppSection.vue';
import NavList from '@components/NavList.vue';
import { Picture } from 'astro:assets';
import WakapiStats from '@components/WakapiStats.astro';
import { mediaFileUrl } from '@services/payload.ts';
import { fetchFundingData, fetchMenu, fetchSocialMenu } from '@services/payload/site.ts';

import { version } from '../../package.json';

const [socialMenu, { platforms }, navMenu1, navMenu2] = await Promise.all([
  fetchSocialMenu(),
  fetchFundingData(),
  fetchMenu('footer1'),
  fetchMenu('footer2'),
]);
const fundingMenu = [
  ...platforms.map((platform) => ({ link: platform.link, title: platform.name })),
  { link: '/spenden', title: 'Alle Spenden-Möglichkeiten' },
];
---

<footer class='o-footer'>
  <div class='o-footer-farewell u-max-body-width'>
    <div class='o-footer-bear'>
      <Picture
        alt='Ein Bär der durch die Stadt läuft'
        fallbackFormat='webp'
        formats={['avif', 'webp']}
        layout='constrained'
        width='700'
        height='451'
        sizes='(min-width: 1024px) 40vw, 48vw'
        widths={[180, 320, 360, 480, 640, 700, 750, 828, 960, 1080, 1280, 1400]}
        src={mediaFileUrl('bear-walking.png')}
      />
    </div>
    {
      Astro.slots.has('farewell') ? (
        <div class='o-footer-farewell-slot'>
          <slot name='farewell' />
        </div>
      ) : (
        <p class='o-footer-farewell-text'>Knorke ditt du mich hier unten besuchst.</p>
      )
    }
  </div>

  <div class='o-footer-ground js-footer-ground'>
    <div class='o-footer-grid u-max-body-width'>
      <div>
        <FooterAppSection client:only='vue' />
      </div>

      <div>
        <p class='o-footer-title'>Seiten</p>
        <NavList
          ariaLabel='Seiten'
          classesUl={'o-footer-nav-list u-list-reset'}
          items={navMenu1}
        />
      </div>

      <div
        data-track-content
        data-content-name='Footer Funding CTA'
        data-content-piece='Projekt unterstützen'
        data-content-target={fundingMenu[0]?.link ?? '/spenden'}
      >
        <p class='o-footer-title'>Projekt unterstützen</p>
        <NavList
          ariaLabel='Projekt unterstützen'
          classesUl={'o-footer-nav-list u-list-reset'}
          items={fundingMenu}
        />
      </div>

      <div>
        <p class='o-footer-title'>Social Media</p>
        <NavList
          ariaLabel='Social Media'
          classesUl={'o-footer-nav-list u-list-reset'}
          items={socialMenu}
        />
      </div>

      <div>
        <p class='o-footer-title'>Andere</p>
        <NavList
          ariaLabel='Andere'
          classesUl={'o-footer-nav-list u-list-reset'}
          items={navMenu2}
        />
      </div>
    </div>
  </div>
</footer>
<div class='o-footer-end'>
  <div class='o-footer-end-content u-max-body-width'>
    <a href='https://github.com/felix-berlin/berliner-schnauze/releases'
      >Website Version: {version}</a
    >
    <p>Ein Projekt von: <a href='https://webshaped.de'>Webshaped / Felix Scholze</a></p>
    <CarbonBadge />
    <p>Hergestellt mit🐻-Kräften in Berlin</p>
    <WakapiStats />
  </div>
</div>
