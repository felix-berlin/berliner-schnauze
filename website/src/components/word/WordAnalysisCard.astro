---
import '@styles/components/_word-analyse.scss';
import AnalysisRows from '@components/word/AnalysisRows.astro';
import SectionCard from '@components/word/SectionCard.astro';
import type { AnalysisRow } from '@lib/wordAnalysis.ts';
import ChevronDown from '~icons/lucide/chevron-down';

interface Props {
  id: string;
  title: string;
  /** Only rows with a value (see `lib/wordAnalysis.ts`); no rows, no card. */
  rows: AnalysisRow[];
}

const { id, rows, title } = Astro.props;
---

{/*
  Grammatik / Klang card (SPEC §11). One markup, two looks: a card with a heading and the rows from the
  main column's 760px up (= viewport 808px), a closed <details> below. The unused one is display: none, so
  nothing is read twice. No heading inside the summary (JAWS/TalkBack drop it).
*/}
{rows.length > 0 && (
  <div class='c-word-analyse'>
    <div class='wide'>
      <SectionCard anchor={false} id={id} title={title} level={3}>
        <AnalysisRows rows={rows} />
      </SectionCard>
    </div>
    <details class='fold'>
      <summary>
        <span class='title'>{title}</span>
        <ChevronDown aria-hidden='true' class='chevron' height='20' width='20' />
      </summary>
      <div class='fold-body'><AnalysisRows rows={rows} /></div>
    </details>
  </div>
)}
