---
import '@styles/components/_word-neighborhood.scss';
import SectionCard from '@components/word/SectionCard.astro';
import { routeToWord } from '@utils/helpers';
import { neighborhoodWords } from '@utils/wordNeighborhood';
import type { RelatedWord } from '@services/payload/words.ts';
import type { WordRef } from '@utils/wordHelper';

interface Props {
  word: string;
  related: RelatedWord[];
  before: WordRef[];
  after: WordRef[];
  /** Slugs the analysis band already lists (similar spelling and sounding). */
  exclude: string[];
}

const { word } = Astro.props;
const { related: relatedShown, before: nearBefore, after: nearAfter } = neighborhoodWords(Astro.props);
const hasNeighbors = nearBefore.length > 0 || nearAfter.length > 0;
---

{(relatedShown.length > 0 || hasNeighbors) && (
  <SectionCard id='verwandte-worte' title='Lexikalisches Umfeld'>
    <div class='c-word-neighborhood'>
      {relatedShown.length > 0 && (
        <div id='verwandte' class='col'>
          <p class='t-label' id='heading-verwandte'>Verwandte Wörter</p>
          <ul class='list' aria-labelledby='heading-verwandte'>
            {relatedShown.map((w) => (
              <li>
                <a class='c-textlink' data-variant='inline' href={routeToWord(w.slug)}>{w.berlinerisch}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
      {hasNeighbors && (
        <nav
          id='navigation'
          class='col'
          aria-labelledby='heading-navigation'
          data-track-content
          data-content-name='Alphabet Navigation'
          data-content-piece={`${nearBefore[0]?.berlinerisch ?? ''} → ${nearAfter[0]?.berlinerisch ?? ''}`}
          data-content-target={routeToWord((nearAfter[0] ?? nearBefore[0])!.slug)}
        >
          <p class='t-label' id='heading-navigation'>Alphabetische Nachbarn</p>
          <ol class='list'>
            {nearBefore.map((w) => (
              <li>
                <a class='c-textlink' data-variant='inline' href={routeToWord(w.slug)}>
                  <span aria-hidden='true'>↑</span>{w.berlinerisch}
                </a>
              </li>
            ))}
            <li class='current' aria-current='page'>
              <span aria-hidden='true'>●</span>{word}
            </li>
            {nearAfter.map((w) => (
              <li>
                <a class='c-textlink' data-variant='inline' href={routeToWord(w.slug)}>
                  <span aria-hidden='true'>↓</span>{w.berlinerisch}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </SectionCard>
)}
