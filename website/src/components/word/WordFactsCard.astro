---
import '@styles/components/_word-wissen.scss';
import SectionCard from '@components/word/SectionCard.astro';
import { FACT_KIND_LABEL } from '@lib/contribute.ts';
import { AFFILIATE_REL, isWebUrl } from '@lib/wordBook.ts';
import type { WordPageModel } from '@services/payload/wordPage.ts';

interface Props {
  word: string;
  /** Slug of the word, for the form. */
  slug?: string;
  facts?: WordPageModel['facts'];
  /** Shown only with a book (chosen by the first theme of the word). */
  book?: WordPageModel['book'];
}

const { facts = [], slug, word } = Astro.props;
// A book link must be http(s); anything else is dropped.
const book = Astro.props.book && isWebUrl(Astro.props.book.url) ? Astro.props.book : undefined;
const gap = {
  cta: 'Wissenswertes ergänzen',
  text: `Noch nüscht Wissenswertes zu „${word}“. Weeßte wat über Herkunft, Geschichte oder haste ’ne Anekdote?`,
};
---

<!-- Wissenswertes card (SPEC §9): facts as a description list; the book block (rule above) only with a book. -->
<SectionCard anchor={false} id='wissenswertes' title='Wissenswertes' level={3} contribute='fact' slug={slug} gap={facts.length ? undefined : gap}>
  {(facts.length > 0 || book) && (
    <div class='c-word-wissen'>
      {facts.length > 0 && (
        <dl class='facts'>
          {facts.map((f) => (
            <div class='fact'>
              <dt class='c-word-label'>{FACT_KIND_LABEL[f.kind] ?? f.kind}</dt>
              <dd class='text'>{f.text}</dd>
              {f.contributor && <dd class='by'>{f.contributor.name ?? 'aus der Community'}</dd>}
            </div>
          ))}
        </dl>
      )}
      {book && (
        <aside class='book'>
          {book.cover && <img class='cover' src={book.cover} alt='' width='48' height='64' loading='lazy' />}
          <div class='info'>
            <p class='c-word-label'>Zum Weiterlesen · Affiliate-Link</p>
            <a class='title' href={book.url} rel={AFFILIATE_REL} data-book-link data-book-title={book.title}>{book.title}</a>
            <p class='note'>Passt zum Thema dieses Worts.{book.disclosure && ` ${book.disclosure}`}</p>
          </div>
        </aside>
      )}
    </div>
  )}
</SectionCard>

<script>
  import { trackBookClicks } from '@lib/bookClickTracking.ts';

  trackBookClicks();
</script>
