---
import type { AffiliateData } from '@services/payload/site.ts';

import { Picture } from 'astro:assets';
import '@styles/components/_book-shelf.scss';
import BookOpen from '~icons/lucide/book-open';

interface Props {
  books: AffiliateData['books'];
  disclaimers: AffiliateData['disclaimers'];
}

const { books: allBooks, disclaimers } = Astro.props;

const hostOf = (href?: string | null) => {
  try {
    return new URL(href ?? '').hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
};
// CMS data: only http(s) links with a parseable host are rendered (no javascript: URLs, no "Bei  ansehen"), at most three books (Spec §2).
const isWebUrl = (href?: string | null) => /^https?:\/\//i.test(href ?? '') && hostOf(href) !== '';
const books = allBooks.filter((b) => isWebUrl(b.href)).slice(0, 3);

// Cover (3:4, object-fit: contain) is 64px wide once .c-word-main is >= 30rem (about 520px viewport, see _book-shelf.scss);
// below that it is height-bound in the 64%-wide card, about 38vw. Widths cover 1x/2x of both.
const COVER_WIDTHS = [64, 128, 192, 320];
const COVER_SIZES = '(min-width: 520px) 64px, 38vw';

// By hostname: "amazon." in a path or query must not count.
const isAmazonLink = (href?: string | null) => /^(.+\.)?(amazon\.(de|com|co\.uk|fr|it|es|nl|pl|se|com\.be|com\.tr|ae|sa|in|co\.jp|com\.au|ca|com\.br|com\.mx|sg|eg|cn)|amzn\.(to|eu)|a\.co)$/i.test(hostOf(href));
const hasAmazon = books.some((b) => isAmazonLink(b.href));
const ctaFor = (href?: string | null) =>
  isAmazonLink(href) ? 'Bei Amazon ansehen' : `Bei ${hostOf(href)} ansehen`;

// The partner statements the CMS holds for the shown platforms (legal text, appended to the Spec copy).
const partnerNotes = disclaimers
  .filter((d) => {
    const plat = d.plattform?.toLowerCase() ?? '';
    if (plat.includes('amazon') && hasAmazon) return true;
    return books.some((b) => hostOf(b.href).toLowerCase() === plat);
  })
  .map((d) => d.text)
  .join(' ');
const noteText = [
  hasAmazon && 'Bezahlte Links zu Amazon.de. Kaufst du darüber, kriegen wa ’ne kleine Provision – für dich bleibt der Preis gleich.',
  partnerNotes,
]
  .filter(Boolean)
  .join(' ');
---

{books.length > 0 && (
  <section class='c-book-shelf' id='buecher' aria-labelledby='heading-buecher'>
    <div class='c-book-shelf__head'>
      <h2 class='c-band' id='heading-buecher'>Ooch als Buch zu haben, wa?</h2>
      <span class='c-badge'>Anzeige</span>
    </div>
    <p class='c-book-shelf__intro'>
      Für Berliner &amp; solche, die es werden wollen – zum Nachschlagen, Rätseln und Verschenken.
    </p>
    <ul class='c-shelf' role='list'>
      {books.map((book) => (
        <li class='c-shelf__item'>
          <a
            class='c-book'
            href={book.href ?? undefined}
            rel='sponsored noopener noreferrer'
            target='_blank'
            data-track-content
            data-content-name='Book Recommendation'
            data-content-piece={book.title}
            data-content-target={book.href}
          >
            <span class='c-book__cover' aria-hidden='true'>
              {book.imageUrl ? (
                <Picture
                  alt=''
                  fallbackFormat='webp'
                  formats={['avif', 'webp']}
                  height={160}
                  loading='lazy'
                  sizes={COVER_SIZES}
                  src={book.imageUrl}
                  width={120}
                  widths={COVER_WIDTHS}
                />
              ) : (
                <BookOpen height='32' width='32' />
              )}
            </span>
            {book.badge && <span class='c-book__tag'>{book.badge}</span>}
            <b class='c-book__title'>{book.title}</b>
            {book.description && <span class='t-small'>{book.description}</span>}
            <span class='c-book__cta'>
              {ctaFor(book.href)} <span aria-hidden='true'>↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    {noteText && <p class='t-small c-book-shelf__note'>{noteText}</p>}
  </section>
)}

<script>
  import { trackEvent } from '@utils/analytics';

  // Delegated + registered once (module scripts run once): survives View Transitions
  // without rebinding per navigation.
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('.c-book');
    if (link) trackEvent('Affiliate', 'Book clicked', link.dataset.contentPiece ?? '');
  });
</script>
