---
import '@styles/components/_word-page-footer.scss';
import { formattedDate } from '@utils/helpers';

interface Props {
  /** ISO dates of the Payload word. */
  modifiedAt?: string | null;
  publishedAt?: string | null;
}

const { modifiedAt, publishedAt } = Astro.props;
---

<footer class='c-word-page-footer'>
  {(publishedAt || modifiedAt) && (
  <p class='t-small'>
    {publishedAt && (
      <span class='created'>Wort erstellt am <time datetime={publishedAt}>{formattedDate(publishedAt)}</time></span>
    )}
    {publishedAt && modifiedAt && ' · '}
    {modifiedAt && (
      <span class='modified'>Bearbeitet am <time datetime={modifiedAt}>{formattedDate(modifiedAt)}</time></span>
    )}
  </p>
  )}
</footer>
