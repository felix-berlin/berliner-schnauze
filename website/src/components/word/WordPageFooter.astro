---
import '@styles/components/_word-page-footer.scss';
import { formattedDate } from '@utils/helpers';

interface Props {
  /** ISO dates of the Payload word. */
  modifiedAt?: string | null;
  publishedAt?: string | null;
}

const { modifiedAt, publishedAt } = Astro.props;
---

<footer class='c-single-word__footer'>
  {publishedAt && (
    <p class='c-single-word__created'>
      Wort erstellt am: <time datetime={publishedAt}>{formattedDate(publishedAt)}</time>
    </p>
  )}
  {modifiedAt && (
    <p class='c-single-word__modified'>
      Bearbeitet am: <time datetime={modifiedAt}>{formattedDate(modifiedAt)}</time>
    </p>
  )}
</footer>
