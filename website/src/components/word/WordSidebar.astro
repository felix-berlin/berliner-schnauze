---
import '@styles/components/_word-sidebar.scss';
import type { SiteWord } from '@services/payload/words.ts';

interface Props {
  word: Pick<SiteWord, 'berlinerisch'>;
  /** Same string as the hero badge. */
  posLabel?: string;
  sections: { id: string; label: string }[];
}

const { word, posLabel, sections } = Astro.props;
---

<aside class='c-word-sidebar'>
  <div class='c-word-sidebar__word'>
    <p class='c-word-sidebar__word-title'>{word.berlinerisch}</p>
    {posLabel && <p class='c-word-sidebar__word-subtitle'>{posLabel}</p>}
  </div>
  <nav class='c-word-sidebar__nav' aria-label='Seitennavigation'>
    {sections.map((section) => <a class='c-word-sidebar__link' href={`#${section.id}`}>{section.label}</a>)}
  </nav>
</aside>

<script>
  import { initScrollSpy, rootMarginBelowHeader } from '@utils/scrollSpy';

  function initSidebarNav() {
    initScrollSpy({
      activeClass: 'is-active',
      getSectionId: (link) => link.getAttribute('href')?.slice(1),
      linkSelector: '.c-word-sidebar__link',
      navSelector: '.c-word-sidebar',
      rootMargin: rootMarginBelowHeader(64),
    });
  }

  document.addEventListener('astro:page-load', initSidebarNav);
</script>
