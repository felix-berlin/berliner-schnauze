---
import '@styles/components/_word-sidebar.scss';
import type { SiteWord } from '@services/payload/words.ts';

interface Props {
  word: Pick<SiteWord, 'berlinerisch'>;
  /** Same string as the hero badge. */
  posLabel?: string;
  sections: { id: string; label: string }[];
}

const { word, posLabel, sections } = Astro.props;
---

<aside class='c-word-sidebar'>
  <div class='word'>
    <p class='title'>{word.berlinerisch}</p>
    {posLabel && <p class='subtitle'>{posLabel}</p>}
  </div>
  <nav class='nav' aria-label='Seitennavigation'>
    {sections.map((section) => <a class='link' href={`#${section.id}`}>{section.label}</a>)}
  </nav>
</aside>

<script>
  import { initHeaderScrollSpy } from '@utils/scrollSpy';

  let stopSpy: (() => void) | undefined;

  function initSidebarNav() {
    stopSpy?.();
    stopSpy = initHeaderScrollSpy({
      getSectionId: (link) => link.getAttribute('href')?.slice(1),
      linkSelector: 'a',
      navSelector: '.c-word-sidebar',
      onActivate: (link, sidebar) => {
        sidebar.querySelectorAll('[aria-current]').forEach((el) => el.removeAttribute('aria-current'));
        link.setAttribute('aria-current', 'true');
      },
    });
  }

  document.addEventListener('astro:page-load', initSidebarNav);
</script>
