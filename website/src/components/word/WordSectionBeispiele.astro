---
import SectionCard from '@components/word/SectionCard.astro';
import WordExamples from '@components/word/WordExamples.astro';
import type { WordExample } from '@services/payload/words.ts';

interface Props {
  examples: WordExample[];
}

const { examples } = Astro.props;
---

{examples.length > 0 && (
  <SectionCard id='beispiele' title='Beispiele'>
    <WordExamples examples={examples} />
  </SectionCard>
)}
