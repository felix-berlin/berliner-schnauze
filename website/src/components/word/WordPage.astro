---
import '@styles/objects/_word-v18.scss';

import WordExamplesCard from '@components/word/WordExamplesCard.astro';
import WordFactsCard from '@components/word/WordFactsCard.astro';
import WordAnalysisCard from '@components/word/WordAnalysisCard.astro';
import WordHead from '@components/word/WordHead.astro';
import WordLinks from '@components/word/WordLinks.astro';
import WordMobileBar from '@components/word/WordMobileBar.astro';
import WordNetworkCard from '@components/word/WordNetworkCard.astro';
import WordNumbers from '@components/word/WordNumbers.astro';
import WordReportLine from '@components/word/WordReportLine.astro';
import WordToc from '@components/word/WordToc.vue';
import { grammarRows, klangRows } from '@lib/wordAnalysis.ts';
import { tocItems } from '@lib/wordToc.ts';
import type { WordPageModel } from '@services/payload/wordPage.ts';
import { voiceSources } from '@composables/useVoicePlayer.ts';
import type { WordRef } from '@utils/wordHelper';

interface Props {
  model: WordPageModel;
  /** Source of the random word in "Und nu?". */
  words?: WordRef[];
}

const { model, words = [] } = Astro.props;
const voices = voiceSources(model.word.berlinerischAudio);
---

<!--
  Shell of the v18 word page (SPEC §2): the table of contents and the main column with the anchors in page
  order. Each section is a named slot; the cards fill them in later tasks (analysis 14; the head of task 12 is the default of `bedeutung`).
  The wrappers own the anchor ids (and the scroll margin): a card placed in a slot must not repeat the id.
-->
<article class='o-word-v18'>
  <!-- No JS, no form: the contribute buttons (wired in Task 17) stay hidden until this flag is set (see _word-v18.scss). -->
  <script is:inline>document.documentElement.dataset.js = '';</script>
  <div class='toc'>
    <WordToc client:idle items={tocItems(model)} />
  </div>

  <div class='main'>
    <div class='anchor' id='bedeutung'>
      <slot name='bedeutung'><WordHead model={model} /></slot>
    </div>

    <h2 class='band'>Im Gebrauch</h2>
    <div class='anchor' id='beispiele'><slot name='beispiele'><WordExamplesCard word={model.word.berlinerisch} examples={model.word.examples} /></slot></div>
    <div class='anchor' id='sagste'><slot name='sagste' /></div>
    <div class='anchor' id='jeschichten'><slot name='jeschichten' /></div>

    <h2 class='band'>Wissen</h2>
    <div class='anchor' id='wissenswertes'><slot name='wissenswertes'><WordFactsCard word={model.word.berlinerisch} facts={model.facts} book={model.book} /></slot></div>
    <div class='anchor' id='verwandt'><slot name='verwandt'><WordNetworkCard model={model} /></slot></div>

    <h2 class='band anchor' id='analyse'>Sprachliche Analyse</h2>
    <div class='pair'>
      <div class='anchor' id='grammatik'><slot name='grammatik'><WordAnalysisCard id='grammatik' title='Grammatik' rows={grammarRows(model)} /></slot></div>
      <div class='anchor' id='klang'><slot name='klang'><WordAnalysisCard id='klang' title='Klang' rows={klangRows(model)} /></slot></div>
    </div>
    <div class='anchor' id='zahlen'><slot name='zahlen'><WordNumbers model={model} /></slot></div>
    <div class='anchor' id='fehler'><slot name='fehler'><WordReportLine word={model.word.berlinerisch} /></slot></div>
    <slot name='weiter'><WordLinks words={words} /></slot>
  </div>
</article>
<!-- Sibling of the article: a sticky bar rests where its parent (the page column) ends, below the content. -->
<WordMobileBar audio={voices.m ?? voices.w} />
