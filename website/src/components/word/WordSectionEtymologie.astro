---
import '@styles/components/_word-section-etymologie.scss';
import SectionCard from '@components/word/SectionCard.astro';
import { hasOrigin } from '@utils/wordSections.ts';
import type { SiteWord } from '@services/payload/words.ts';

interface Props {
  word: Pick<SiteWord, 'infoTextHtml' | 'sources'>;
}

const { word } = Astro.props;

// ACF checkbox choices may carry a link as "Label : https://…" — split only
// on the spaced colon so titles like "Berlinisch: Lexikon" stay intact.
const sources = (word.sources ?? [])
  .filter(Boolean)
  .map((raw) => {
    const [label, url] = raw.split(' : ');
    return url?.startsWith('http') ? { label: label ?? raw, url } : { label: raw, url: null };
  });
---

{hasOrigin(word) && (
  <SectionCard id='etymologie' title='Etymologie'>
    {word.infoTextHtml && <div class='c-word-origin' set:html={word.infoTextHtml} />}
    {sources.length > 0 && (
      <Fragment slot='footer'>
        <span class='t-label'>{sources.length === 1 ? 'Quelle' : 'Quellen'}</span>
        {sources.map((source) =>
          source.url ? (
            <a class='c-textlink c-textlink--inline c-word-origin__source' href={source.url} rel='noopener'>
              {source.label}
            </a>
          ) : (
            <span>{source.label}</span>
          ),
        )}
      </Fragment>
    )}
  </SectionCard>
)}
