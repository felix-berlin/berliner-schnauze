---
import '@styles/components/_word-hero.scss';
import AudioPlayerList from '@components/AudioPlayerList.vue';
import BadgeTag from '@components/BadgeTag.vue';
import IsWordOfTheDay from '@components/word/IsWordOfTheDay.vue';
import WordMeanings from '@components/word/WordMeanings.vue';
import WordOptionDropdown from '@components/word/WordOptionDropdown.vue';
import WordReactions from '@components/word/WordReactions.vue';
import TooltipPopover from '@components/TooltipPopover.vue';
import { routeToWord } from '@utils/helpers';
import { posBadge } from '@utils/wordPos';
import type { WordTrend } from '@utils/wordTrend.ts';
import TrendingUp from '~icons/lucide/trending-up';
import type { SiteWord } from '@services/payload/words.ts';

interface Props {
  word: SiteWord;
  /** Same word type as sidebar and grammar card, without the "(geraten)" suffix. */
  pos?: string | undefined;
  /** The word type is the automatic guess, not an editor's choice. */
  posAuto?: boolean;
  meanings?: string[];
  /** A draft preview has no public votes. */
  draft?: boolean;
  trend?: Pick<WordTrend, 'rank'> | undefined;
}

const { word, pos, posAuto = false, meanings = [], draft = false, trend } = Astro.props;
const { themen } = word;
const badge = pos ? posBadge(pos, posAuto) : undefined;
const same = (word.alternativeWords ?? []).map((w) => w.alternativeWord).filter(Boolean).join(', ');
---

<header
  id='bedeutung'
  class='c-word-hero'
  data-track-content
  data-content-name='Word Hero'
  data-content-piece={word.berlinerisch}
  data-content-target={routeToWord(word.slug)}
>
  <div class='c-word-hero__head'>
    <h1 class='c-word-hero__title'>
      <dfn class='c-headword'>{word.berlinerisch}</dfn>{word.article && (
        <span class='c-word-hero__word-article'>, {word.article}</span>
      )}
    </h1>
    {/* Before the badges in the DOM: focus order is Like, ⋮, category (Spec §14). */}
    <div class='c-word-hero__actions'>
      {!draft && <WordReactions client:idle wordId={word.id} />}
      <WordOptionDropdown
        berlinerisch={word.berlinerisch}
        client:load
        slug={word.slug}
        variant='word'
        wordId={draft ? undefined : word.id}
      />
    </div>
    <div class='c-word-hero__badges'>
      {
        badge && (
          <span
            class:list={['c-badge', { 'c-badge--auto': badge.auto }]}
            title={badge.auto ? 'Automatisch erkannt, kann abweichen' : undefined}
          >
            {badge.text}
          </span>
        )
      }
      {
        word.berolinismus && (
          <TooltipPopover client:only='vue'>
            <BadgeTag> Berolinismus </BadgeTag>
            <Fragment slot='tooltip'>
              {word.berlinerisch} gehört zu den Berlinismen.
              <>
                <br />
                <br />
              </>
              <strong>Berolinismus</strong> sind humorvolle Spitznamen und Eigenheiten, die
              bestimmte Orte und Gebäude in Berlin charakterisieren und das lokale Flair der Stadt
              prägen.
            </Fragment>
          </TooltipPopover>
        )
      }
      <IsWordOfTheDay
        client:only='vue'
        variant='badge'
        word={word.berlinerisch}
        slug={word.slug}
      />
      {
        themen.map((thema) => (
          <a href={`/themen/${thema.slug}`} class='c-textlink c-textlink--inline t-small c-word-hero__category'>
            {thema.name}
          </a>
        ))
      }
      {/* Visually first (order: -1), but after the category in the DOM: focus order is Like, ⋮, category, …, trend link (Spec §14). */}
      {
        trend && (
          <a href='#n-trend' class='c-badge c-badge--strong c-word-hero__trend-badge'>
            <TrendingUp width='12' height='12' aria-hidden='true' />
            Im Trend · Platz {trend.rank}
          </a>
        )
      }
      {
        word.berlinerischAudio.length > 0 && (
          <AudioPlayerList
            audio={word.berlinerischAudio}
            client:only='vue'
            isType='berlinerisch'
            wordId={draft ? undefined : word.id}
          />
        )
      }
    </div>
  </div>
  {
    (meanings.length > 0 || same) && (
      <div class='c-word-hero__meaning'>
        {meanings.length > 0 && <WordMeanings client:idle meanings={meanings} />}
        {same && (
          <p class='c-word-hero__same'>
            Selbe Bedeutung wie <span>{same}</span>
          </p>
        )}
      </div>
    )
  }
  {/* The image column (class c-word-hero__images, spans the rows from 1000px) joins this grid. */}
</header>
