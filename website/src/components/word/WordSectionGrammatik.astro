---
import '@styles/components/_section-card.scss';
import { capitalizeFirstLetter } from '@utils/wordHelper';

interface Props {
  /** The word type shown in badge and sidebar; for a single word it is the card's type too. */
  pos?: string | undefined;
  wordTags: Record<string, string[]>[];
}

const { pos, wordTags } = Astro.props;
const tokens = Object.keys(wordTags[0] ?? {});
const tagsOf = (key: string): string[] => {
  const tags = wordTags[0][key];
  return tokens.length === 1 && pos ? [pos, ...tags.slice(1)] : tags;
};
---

{
  wordTags.length > 0 && (
    <section class='c-section-card' id='grammatik' aria-labelledby='heading-grammatik'>
      <div class='c-section-card__header'>
        <span class='c-section-card__num'></span>
        <h2 class='c-section-card__title' id='heading-grammatik'>Grammatik</h2>
      </div>
      <div class='c-section-card__body'>
        <p class='c-section-card__grammar-label'>Wortart (NLP-Analyse)</p>
        {tokens.map((key) => {
          const tags = tagsOf(key);
          const isNomenPresent = tags.includes('Nomen');
          return (
            <div class='c-section-card__grammar-entry'>
              <div class='c-section-card__grammar-word'>
                {isNomenPresent ? capitalizeFirstLetter(key) : key}
              </div>
              <div class='c-section-card__grammar-tags'>
                {tags.map((tag) => (
                  <span class='c-section-card__grammar-tag'>{tag}</span>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )
}
