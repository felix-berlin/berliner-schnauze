---
import '@styles/components/_word-trend.scss';
import { formatChange, type WordTrend } from '@utils/wordTrend.ts';

type Props = WordTrend;

const { rank, views, change, bars } = Astro.props;
const changeText = formatChange(change);
const max = Math.max(...bars, 1);
---

<section id='n-trend' class='c-word-trend' aria-labelledby='n-trend-t'>
  <div class='text'>
    <p id='n-trend-t' class='t-label label'>Trendet jerade</p>
    <p class='rank'><b class='t-em'>Platz {rank}</b> diese Woche</p>
    <p class='t-small meta'>
      {views.toLocaleString('de-DE')} Aufrufe in 7 Tagen{changeText && ` · ${changeText} zur Vorwoche`}
    </p>
  </div>
  <div class='bars' aria-hidden='true'>
    {bars.map((v) => <span style={`height: ${Math.max(10, Math.round((v / max) * 100))}%`} />)}
  </div>
  {/* No trending page exists yet: the word index is the closest route. */}
  <div class='more'>
    <a class='c-textlink t-small' data-variant='inline' href='/wort'>
      Alle Trend-Wörter ansehen →
    </a>
  </div>
</section>
