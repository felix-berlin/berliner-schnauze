---
import '@styles/components/_word-decomposition.scss';
import { decomposeCompoundWord, capitalizeFirstLetter } from '@utils/wordHelper';
import { routeToWord } from '@utils/helpers';
import type { WordRef } from '@utils/wordHelper';

interface Props {
  word: string;
  allWords: WordRef[];
}

const { word, allWords } = Astro.props;
const parts = decomposeCompoundWord(word);

// Only needed to link parts — skip the ~6000-entry lookup for non-compounds.
// findLast keeps the previous Map semantics (last duplicate wins).
const findWord = (part: string) =>
  allWords.findLast((w) => w.wordProperties.berlinerisch.toLowerCase() === part);
---

{
  parts && parts.length >= 2 && (
    <div>
      <h3>Wortzerlegung</h3>
      <div class='c-single-word__word-parts'>
        {parts.map((part, i) => {
          const linked = findWord(part);
          return (
            <>
              {i > 0 && <span class='c-single-word__word-parts-plus'>+</span>}
              {linked ? (
                <a class='c-single-word__word-part' href={routeToWord(linked.slug)}>
                  {capitalizeFirstLetter(part)}
                </a>
              ) : (
                <span class='c-single-word__word-part'>{capitalizeFirstLetter(part)}</span>
              )}
            </>
          );
        })}
      </div>
    </div>
  )
}
