---
import '@styles/components/_word-examples.scss';
import VoiceButtons from "@components/word/VoiceButtons.vue";
import { voiceSources } from "@composables/useVoicePlayer.ts";

import type { WordExample } from "@services/payload/words.ts";

interface WordExamplesProps {
  examples?: WordExample[];
}

const { examples = [] } = Astro.props as WordExamplesProps;
---

{examples.length > 0 && <ol class='c-word-examples'>
  {examples.map((item, index) => {
    const sources = voiceSources(item.exampleAudio);
    return (
      <li class='c-word-examples__item'>
        <blockquote class='c-word-examples__quote'>
          <p class='t-em c-word-examples__text'>
            <span aria-hidden='true' class='c-word-examples__mark'>“</span>{item.example}
          </p>
          {item.exampleExplanation && <p class='c-word-examples__explanation'>{"– " + item.exampleExplanation}</p>}
        </blockquote>
        {(sources.m || sources.w) && (
          <VoiceButtons aria-label={`Beispiel ${index + 1} anhören`} client:visible sources={sources} />
        )}
      </li>
    );
  })}
</ol>}
