---
import '@styles/components/_word-learn-more.scss';
import ExternalLink from '~icons/lucide/external-link';

interface Props {
  learnMore: string;
}

const { learnMore } = Astro.props;
---

<a
  class='c-word-learn-more'
  href={learnMore}
  rel='noopener noreferrer'
  target='_blank'
  title='mehr zu diesem Wort auf Wikipedia'
>
  Erfahre mehr über dieses Wort
  <span class='icon'>
    <ExternalLink height='10' width='10' />
  </span>
</a>
