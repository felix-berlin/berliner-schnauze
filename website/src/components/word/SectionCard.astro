---
import '@styles/components/_section-card.scss';

interface Props {
  id: string;
  title: string;
  level?: 2 | 3;
}

const { id, title, level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
// Slots passed as `cond && …` still count as present, so test the rendered output.
const body = (await Astro.slots.render('default'))?.trim();
const footer = (await Astro.slots.render('footer'))?.trim();
const headingId = `heading-${id}`;
---

<section class='c-section-card' data-variant='word' id={id} aria-labelledby={headingId}>
  <div class='header'>
    <Heading class='title' id={headingId}>{title}</Heading>
  </div>
  {body && <div class='body' data-slot set:html={body} />}
  {footer && <footer class='footer t-small' data-slot set:html={footer} />}
</section>
