---
import '@styles/components/_word-fehler.scss';
import Flag from '~icons/lucide/flag';

interface Props {
  word: string;
}

const { word } = Astro.props;
---

{/* „Stimmt wat nich?“ (SPEC §12, rest state): one line with a rule above, no card. The button is wired in Task 17 (`data-report`), hidden without JS. */}
<section class='c-word-fehler' aria-labelledby='fehler-title'>
  <div class='inner'>
  <p class='text'><b id='fehler-title'>Stimmt wat nich?</b> Wenn dir bei „{word}“ wat falsch vorkommt, sag Bescheid.</p>
  <button class='report' type='button' data-report>
    <Flag aria-hidden='true' height='18' width='18' />
    Fehler melden
  </button>
  </div>
</section>
