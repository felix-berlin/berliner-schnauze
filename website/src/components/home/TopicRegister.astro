---
import type { HomeData } from "@services/payload/home.ts";

interface Props {
  topics: HomeData["topics"];
}

const { topics } = Astro.props;
---

{/* SPEC §19: below three topics the whole register drops. */}
{
  topics.length >= 3 && (
    <div class="c-home-topics">
      <header class="head">
        <p class="eyebrow" aria-hidden="true">
          <s>Nach Themen stöbern</s>
        </p>
        <h2>Kiek ma rin</h2>
        {/* DOM order = visual order (WCAG 1.3.2), unlike SPEC §17, which tabs the rows first. */}
        <a href="/themen" class="all">Alle Themen</a>
      </header>
      {/* role="list": Safari drops list semantics of an unstyled list (list-style: none). */}
      <ol class="register" role="list">
        {topics.map((t, i) => (
          <li>
            <a href={`/themen/${t.slug}`} class="row">
              <span class="no">{String(i + 1).padStart(2, "0")}</span>
              <span class="name">{t.name}</span>
              {t.examples.length > 0 && <span class="examples">{t.examples.join(", ")}</span>}
              <span class="count">
                {t.count.toLocaleString("de-DE")}
                <small>Wörter</small>
              </span>
              {t.saying && (
                <span class="say" aria-hidden="true">
                  „{t.saying}“
                </span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style lang="scss" is:global>
  @use "@styles/components/home-topics";
</style>
