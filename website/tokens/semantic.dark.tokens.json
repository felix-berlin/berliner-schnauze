{
  "color": {
    "$type": "color",
    "text": {
      "body": {
        "$value": "{color.cream.500}"
      },
      "strong": {
        "$value": "{color.white.100}"
      },
      "muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.709804, 0.717647, 0.67549],
          "hex": "#b5b7ac"
        }
      },
      "accent": {
        "$value": "{color.orange.300}"
      },
      "on-accent": {
        "$value": "{color.white.100}"
      },
      "on-overlay": {
        "$value": "{color.white.100}"
      },
      "on-active": {
        "$value": "{color.white.pure}"
      }
    },
    "surface": {
      "hero": {
        "$value": "{color.ink.400m}"
      },
      "sheet": {
        "$value": "{color.ink.400m}"
      },
      "paper": {
        "$value": "{color.ink.400m}"
      },
      "chip": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.18811, 0.2112, 0.23429],
          "hex": "#30363c"
        }
      },
      "callout": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.18811, 0.2112, 0.23429],
          "hex": "#30363c"
        }
      },
      "badge": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.18811, 0.2112, 0.23429],
          "hex": "#30363c"
        }
      },
      "wash": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.811765, 0.341176, 0.211765],
          "hex": "#cf5736",
          "alpha": 0.15
        }
      },
      "tint": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff",
          "alpha": 0.1
        }
      },
      "floating": {
        "$value": "{color.ink.200m}"
      },
      "overlay": {
        "$value": "{color.black.pure}"
      },
      "page": {
        "$value": "{color.ink.300m}"
      },
      "field": {
        "$value": "{color.ink.600m}"
      },
      "field-disabled": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.235471, 0.260647, 0.278323],
          "hex": "#3c4247"
        }
      },
      "check": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.750588, 0.76, 0.769412],
          "hex": "#bfc2c4"
        }
      },
      "check-disabled": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.90902, 0.629804, 0.513725],
          "hex": "#e8a183"
        }
      },
      "range-track": {
        "$value": "{color.ink.600m}"
      },
      "range-track-moz": {
        "$value": "{color.grey.200}"
      },
      "selection": {
        "$value": "{color.ink.200}"
      }
    },
    "accent": {
      "solid": {
        "$value": "{color.orange.600}"
      },
      "icon": {
        "$value": "{color.orange.400}"
      },
      "active": {
        "$value": "{color.orange.500}"
      }
    },
    "border": {
      "card": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.941176, 0.67451, 0.521569],
          "hex": "#f0ac85",
          "alpha": 0.25
        }
      },
      "inner": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.941176, 0.67451, 0.521569],
          "hex": "#f0ac85",
          "alpha": 0.3
        }
      },
      "control": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.334902, 0.36, 0.385098],
          "hex": "#555c62"
        }
      },
      "control-hover": {
        "$value": "{color.red.200}"
      },
      "check": {
        "$value": "{color.ink.base}"
      },
      "check-disabled": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.931765, 0.722353, 0.635294],
          "hex": "#eeb8a2"
        }
      },
      "fieldset": {
        "$value": "{color.grey.200}"
      }
    },
    "control": {
      "bg": {
        "$value": "{color.ink.600m}"
      },
      "text": {
        "$value": "{color.cream.500}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.orange.400}"
      },
      "halo": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.698039, 0.231373, 0.152941],
          "hex": "#b23b27",
          "alpha": 0.3
        }
      }
    },
    "status": {
      "danger": {
        "$value": "{color.danger}"
      },
      "success": {
        "$value": "{color.success}"
      },
      "gold": {
        "$value": "{color.gold}"
      }
    },
    "pattern": {
      "dot": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.250434, 0.27872, 0.307006],
          "hex": "#40474e"
        }
      },
      "ground": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.168627, 0.2, 0.231373],
          "hex": "#2b333b",
          "alpha": 0.7
        }
      }
    },
    "scrollbar": {
      "thumb": {
        "$value": "{color.ink.800}"
      },
      "track": {
        "$value": "{color.ink.100}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "paper-lift": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "hex": "#000000",
            "alpha": 0.08
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0.5,
            "unit": "px"
          },
          "blur": {
            "value": 0.6,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "hex": "#000000",
            "alpha": 0.16
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 5,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    },
    "hover-glow": {
      "$value": {
        "color": "{color.orange.500}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0,
          "unit": "px"
        },
        "blur": {
          "value": 12,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
