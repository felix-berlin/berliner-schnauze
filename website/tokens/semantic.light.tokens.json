{
  "color": {
    "$type": "color",
    "text": {
      "body": {
        "$value": "{color.ink.base}"
      },
      "strong": {
        "$value": "{color.ink.400m}"
      },
      "muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.376471, 0.4, 0.423529],
          "hex": "#60666c"
        }
      },
      "accent": {
        "$value": "{color.orange.600}"
      },
      "on-accent": {
        "$value": "{color.white.100}"
