---
import "@styles/components/_menu-nav.scss";
import ColorModeToggle from "@components/ColorModeToggle.vue";
import MainMenu from "@components/header/MainMenu.vue";
import SearchModalTrigger from "@components/modals/search/SearchModalTrigger.vue";
import SunMoonIcon from "virtual:icons/lucide/sun-moon";
import { fetchMenu } from "@services/queries/getMenu";

const isIndex = /^\/(index(\.html)?)?$/.test(Astro.url.pathname);
const mainMenuItems = await fetchMenu("Main Menu");
---

<header class="c-header">
  <div class="c-header__wrapper u-max-body-width">
    <div class="c-logo">
      <a class="c-logo__link" href="/"> Berliner Schnauze</a>
    </div>

    <nav class="c-menu-nav" aria-label="Hauptnavigation">
      {!isIndex && <SearchModalTrigger client:load />}

      <ColorModeToggle client:only="vue" cssClasses={"c-menu-nav__item c-menu-nav__item-button"}>
        <button
          class="c-color-mode-toggle c-button c-button--center-icon"
          slot="fallback"
          type="button"
          aria-label="Farbschema wechseln"
        >
          <SunMoonIcon aria-hidden="true" />
        </button>
      </ColorModeToggle>

      <MainMenu client:load menuItems={mainMenuItems} />
    </nav>
  </div>
</header>

<script>
  // Runs once: the header is `transition:persist`ed, so the element (and this observer)
  // survive client-side navigations. Pages read --site-header-height for sticky offsets.
  function syncHeaderHeight() {
    const header = document.querySelector<HTMLElement>('.c-header');
    if (!header) return;
    const h = Math.round(header.getBoundingClientRect().height);
    // View Transitions can briefly report 0 for persisted elements.
    if (h > 0) {
      document.documentElement.style.setProperty('--site-header-height', h + 'px');
    }
  }

  const siteHeader = document.querySelector<HTMLElement>('.c-header');
  if (siteHeader) {
    new ResizeObserver(syncHeaderHeight).observe(siteHeader);
  }

  document.addEventListener('astro:page-load', syncHeaderHeight);
</script>
