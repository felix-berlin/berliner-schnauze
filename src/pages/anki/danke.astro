---
import '@styles/components/_button.scss';
import Layout from '@layouts/Layout.astro';
import { getPolarFullDeckPrice } from '@services/polar.ts';
import ArrowLeft from 'virtual:icons/lucide/arrow-left';
import BookOpen from 'virtual:icons/lucide/book-open';
import Check from 'virtual:icons/lucide/check';

// Polar liefert "5,99 €"; Matomo braucht die Zahl als Ereigniswert (= Umsatz des Ziels).
const price = (await getPolarFullDeckPrice())?.replace(/[^\d,]/g, '').replace(',', '.');

const page = { title: 'Danke für Deinen Kauf - Berliner Schnauze' };

const steps = [
  'Polar schickt Dir eine Mail mit dem Download-Link. Schau zur Not im Spam-Ordner nach.',
  'Lad die Full-Datei (.apkg) runter und öffne sie mit Anki.',
  'Anki ergänzt nur die fehlenden Wörter. Dein Lernstand bleibt, doppelte Karten gibt’s keine.',
];
---

<Layout content={page}>
  <Fragment slot='head'>
    <meta content='noindex' name='robots' />
  </Fragment>
  <section class='c-anki-thanks' aria-labelledby='anki-thanks-title' data-price={price}>
    <span class='c-anki-thanks__stamp'><Check width='34' height='34' stroke-width='3' /></span>
    <h1 id='anki-thanks-title' class='c-anki-thanks__title'>Danke, dit hat geklappt!</h1>
    <p class='c-anki-thanks__lead'>
      Mit Deinem Kauf hältst Du die Schnauze am Laufen. Und so kommst Du an Dein Deck:
    </p>
    <ol class='c-anki-thanks__steps'>
      {steps.map((step) => <li>{step}</li>)}
    </ol>
    <div class='c-anki-thanks__actions'>
      <a class='c-button c-button--primary c-button--center-icon' href='/wort'>
        <BookOpen width='20' height='20' /><span>Zum Wörterbuch</span>
      </a>
      <a class='c-button c-button--center-icon' href='/anki'>
        <ArrowLeft width='20' height='20' /><span>Zurück zur Anki-Seite</span>
      </a>
    </div>
  </section>
</Layout>

<script>
  import { trackEvent } from '@utils/analytics';

  // Matomo-Ziel "Full-Deck gekauft": Ereignisaktion "Purchase Full", Ereigniswert = Umsatz.
  // Pro Checkout nur einmal zählen, auch bei Reload.
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('.c-anki-thanks');
    if (!el) return;
    const key = `anki-purchase-${new URLSearchParams(location.search).get('checkout_id') ?? ''}`;
    try {
      if (sessionStorage.getItem(key)) return;
      sessionStorage.setItem(key, '1');
    } catch {
      // Storage gesperrt: lieber einmal zu oft als gar nicht zählen
    }
    const price = Number(el.dataset.price);
    trackEvent('Anki', 'Purchase Full', 'full-deck', price > 0 ? price : undefined);
  });
</script>

<style lang='scss' is:global>
  @use '@styles/pages/anki-danke';
</style>
